    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">MonsterService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- The Blind One. It cannot see. It builds a picture of the world from noise events
-- (footsteps, thrown rocks, doors) and the continuous noise meter of nearby players.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local MonsterAppearance = require(script.Parent:WaitForChild("MonsterAppearance"))
local MazeLayout = require(ReplicatedStorage:WaitForChild("MazeLayout"))

local noiseBindable = ServerStorage:WaitForChild("Noise") :: BindableEvent
local catchBindable = ServerStorage:WaitForChild("CatchPlayer") :: BindableEvent
local photoFrozen = false

local function humanBlindOne(): Player?
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Role") == "BlindOne" then
			return player
		end
	end
	return nil
end

-- Rojo can restart this script during a live playtest. Remove the model made by
-- the previous run so hot-syncing never leaves duplicate monsters behind.
for _, child in workspace:GetChildren() do
	if child.Name == "TheBlindOne" then
		child:Destroy()
	end
end

local AGENT = {
	-- The generated forest routes are about ten studs wide, but rocks and set
	-- dressing can narrow the baked navigation channel. The monster itself is
	-- collisionless, so a slightly smaller planning radius is both accurate and
	-- much less likely to reject an otherwise clear route.
	AgentRadius = 2.25,
	AgentHeight = 7,
	AgentCanJump = false,
	WaypointSpacing = 5,
}

------------------------------------------------------------------- build the body
local monster = Instance.new("Model")
monster.Name = "TheBlindOne"

local ROOT_Y = 3.9 -- centre height so the figure's feet sit near the floor (floor top = 0)

local root = Instance.new("Part")
root.Name = "HumanoidRootPart"
root.Size = Vector3.new(2.4, 7, 1.6)
root.Transparency = 1 -- invisible; the figure below is cosmetic
root.CanCollide = false
root.Anchored = true -- moved directly by CFrame, no ragdoll physics / replication stutter
root.Parent = monster
monster.PrimaryPart = root

local function rigPart(name: string, size: Vector3, position: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Transparency = 1
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.Parent = monster
	p.CFrame = root.CFrame * CFrame.new(position)
	return p
end

local lowerTorso = rigPart("LowerTorso", Vector3.new(1.25, 1, 0.8), Vector3.new(0, -0.05, 0))
local upperTorso = rigPart("UpperTorso", Vector3.new(2.15, 1.65, 0.9), Vector3.new(0, 1.2, 0))
local head = rigPart("Head", Vector3.new(1.2, 1.25, 1), Vector3.new(0, 2.75, 0))
local rightUpperArm = rigPart("RightUpperArm", Vector3.new(0.65, 1.5, 0.65), Vector3.new(1.3, 0.95, 0))
local rightLowerArm = rigPart("RightLowerArm", Vector3.new(0.6, 1.5, 0.6), Vector3.new(1.46, -0.45, 0))
local rightHand = rigPart("RightHand", Vector3.new(0.65, 0.75, 0.6), Vector3.new(1.48, -1.65, 0))
local leftUpperArm = rigPart("LeftUpperArm", Vector3.new(0.65, 1.5, 0.65), Vector3.new(-1.3, 0.95, 0))
local leftLowerArm = rigPart("LeftLowerArm", Vector3.new(0.6, 1.5, 0.6), Vector3.new(-1.46, -0.45, 0))
local leftHand = rigPart("LeftHand", Vector3.new(0.65, 0.75, 0.6), Vector3.new(-1.48, -1.65, 0))
local rightUpperLeg = rigPart("RightUpperLeg", Vector3.new(0.7, 1.65, 0.75), Vector3.new(0.5, -1.05, 0))
local rightLowerLeg = rigPart("RightLowerLeg", Vector3.new(0.65, 1.55, 0.7), Vector3.new(0.5, -2.55, 0))
local rightFoot = rigPart("RightFoot", Vector3.new(0.75, 0.45, 1.1), Vector3.new(0.5, -3.48, -0.2))
local leftUpperLeg = rigPart("LeftUpperLeg", Vector3.new(0.7, 1.65, 0.75), Vector3.new(-0.5, -1.05, 0))
local leftLowerLeg = rigPart("LeftLowerLeg", Vector3.new(0.65, 1.55, 0.7), Vector3.new(-0.5, -2.55, 0))
local leftFoot = rigPart("LeftFoot", Vector3.new(0.75, 0.45, 1.1), Vector3.new(-0.5, -3.48, -0.2))

local function rigJoint(name: string, parentPart: BasePart, childPart: BasePart, jointPosition: Vector3)
	local jointWorld = root.CFrame * CFrame.new(jointPosition)
	local joint = Instance.new("Motor6D")
	joint.Name = name
	joint.Part0 = parentPart
	joint.Part1 = childPart
	joint.C0 = parentPart.CFrame:ToObjectSpace(jointWorld)
	joint.C1 = childPart.CFrame:ToObjectSpace(jointWorld)
	joint.Parent = childPart
end

rigJoint("Root", root, lowerTorso, Vector3.new(0, 0.15, 0))
rigJoint("Waist", lowerTorso, upperTorso, Vector3.new(0, 0.52, 0))
rigJoint("Neck", upperTorso, head, Vector3.new(0, 2.05, 0))
rigJoint("RightShoulder", upperTorso, rightUpperArm, Vector3.new(1.06, 1.58, 0))
rigJoint("RightElbow", rightUpperArm, rightLowerArm, Vector3.new(1.42, 0.22, 0))
rigJoint("RightWrist", rightLowerArm, rightHand, Vector3.new(1.48, -1.2, 0))
rigJoint("LeftShoulder", upperTorso, leftUpperArm, Vector3.new(-1.06, 1.58, 0))
rigJoint("LeftElbow", leftUpperArm, leftLowerArm, Vector3.new(-1.42, 0.22, 0))
rigJoint("LeftWrist", leftLowerArm, leftHand, Vector3.new(-1.48, -1.2, 0))
rigJoint("RightHip", lowerTorso, rightUpperLeg, Vector3.new(0.5, -0.45, 0))
rigJoint("RightKnee", rightUpperLeg, rightLowerLeg, Vector3.new(0.5, -1.82, 0))
rigJoint("RightAnkle", rightLowerLeg, rightFoot, Vector3.new(0.5, -3.25, 0))
rigJoint("LeftHip", lowerTorso, leftUpperLeg, Vector3.new(-0.5, -0.45, 0))
rigJoint("LeftKnee", leftUpperLeg, leftLowerLeg, Vector3.new(-0.5, -1.82, 0))
rigJoint("LeftAnkle", leftLowerLeg, leftFoot, Vector3.new(-0.5, -3.25, 0))

local humanoid = Instance.new("Humanoid")
humanoid.Name = "Humanoid"
humanoid.WalkSpeed = 0 -- movement is done by CFrame; the Humanoid is just for Health/death
humanoid.AutoRotate = false
humanoid.BreakJointsOnDeath = false
humanoid.EvaluateStateMachine = false
humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
humanoid.NameDisplayDistance = 0
humanoid.HealthDisplayDistance = 0
humanoid.Parent = monster

-- Solo AI and the player-controlled role share one appearance source. The
-- hidden target skeleton above gives the imported mesh real joints to follow.
MonsterAppearance.Apply(monster)

local photoOwner: Player? = nil
local function stopPhotoMode()
	local owner = photoOwner
	photoOwner, photoFrozen = nil, false
	monster:SetAttribute("PhotoFrozen", false)
	if owner and owner.Parent == Players then Remotes.PhotoMode:FireClient(owner, false) end
end
Players.PlayerRemoving:Connect(function(player)
	if player == photoOwner then stopPhotoMode() end
end)
Remotes.PhotoMode.OnServerEvent:Connect(function(player: Player, requested: boolean?)
	-- Photo mode is a Studio-only solo-testing aid; it can never freeze a live
	-- game or a player-controlled Blind One.
	if player == photoOwner and (requested == false or photoFrozen) then
		stopPhotoMode()
		return
	end
	if not RunService:IsStudio() or humanBlindOne() or requested == false then
		return
	end
	if photoOwner then return end
	photoOwner, photoFrozen = player, true
	monster:SetAttribute("PhotoFrozen", photoFrozen)
	Remotes.PhotoMode:FireClient(player, photoFrozen)
end)

------------------------------------------------------------------- patrol points
local function gatherNodes(): { Vector3 }
	local nodes: { Vector3 } = {}
	for _, inst in CollectionService:GetTagged("PatrolNode") do
		if inst:IsA("BasePart") then
			table.insert(nodes, inst.Position)
		end
	end
	return nodes
end

------------------------------------------------------------------- start / spawn
local patrolNodes: { Vector3 } = {}
local spawnReady = false

local function spawnMonster()
	-- wait until MapBuilder has actually placed nodes
	for _ = 1, 40 do
		patrolNodes = gatherNodes()
		if #patrolNodes > 0 then
			break
		end
		task.wait(0.25)
	end
	if #patrolNodes == 0 then
		warn("MonsterService: no PatrolNodes found -- is MapBuilder erroring? Monster not spawned.")
		return
	end

	-- start on the node farthest from the player spawn pad
	local spawnPart = workspace:FindFirstChild("GeneratedMap")
		and (workspace.GeneratedMap :: Instance):FindFirstChild("Spawn") :: BasePart?
	local origin = spawnPart and spawnPart.Position or Vector3.zero
	local start = patrolNodes[1]
	local bestD = -1
	for _, node in patrolNodes do
		local d = (node - origin).Magnitude
		if d > bestD then
			bestD, start = d, node
		end
	end
	monster:PivotTo(CFrame.new(Vector3.new(start.X, ROOT_Y, start.Z)))
	spawnReady = true
	if not humanBlindOne() then
		monster.Parent = workspace
	end
end

------------------------------------------------------------------- hearing model
type Heard = {
	pos: Vector3,
	strength: number,
	at: number,
	player: Player?,
	arrivedAt: number?,
}
local heard: Heard? = nil

local function registerNoise(pos: Vector3, loudness: number, player: Player?)
	if not monster.Parent then
		return
	end
	local dist = (pos - root.Position).Magnitude
	local strength = loudness - dist / Config.NoiseCarry
	if strength < Config.MonsterHearingFloor then
		return
	end
	-- the freshest sufficiently-strong sound wins; a much louder one always wins
	if not heard or strength >= heard.strength - 4 or os.clock() - heard.at > 1.5 then
		heard = {
			pos = pos,
			strength = strength,
			at = os.clock(),
			player = player,
			arrivedAt = nil,
		}
	end
end

noiseBindable.Event:Connect(function(pos: Vector3, loudness: number)
	registerNoise(pos, loudness, nil)
end)

------------------------------------------------------------------- main AI loop
local state = "wander" -- "wander" | "investigate" | "hunt"
local wanderGoal: Vector3? = nil
local lastHuntHeard = 0
local targetSpeed = Config.MonsterWanderSpeed
local currentSpeed = Config.MonsterWanderSpeed

local function nearestNode(from: Vector3): Vector3
	if #patrolNodes == 0 then
		return from
	end
	local pick = patrolNodes[math.random(#patrolNodes)]
	-- bias slightly toward a random-but-not-current node so it roams
	if wanderGoal and (pick - wanderGoal).Magnitude < 6 and #patrolNodes > 1 then
		pick = patrolNodes[math.random(#patrolNodes)]
	end
	return pick
end

local function pollPlayers()
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Role") == "BlindOne" then
			continue
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local meter = player:GetAttribute("Noise")
			if typeof(meter) == "number" and meter > 0 then
				registerNoise(hrp.Position, meter, player)
			end
		end
	end
end

local function decide()
	local now = os.clock()
	if heard then
		local age = now - heard.at
		local distToHeard = (heard.pos - root.Position).Magnitude
		local escalate = heard.player ~= nil
			and heard.strength > Config.MonsterHuntNoise
			and distToHeard < Config.MonsterHuntRange
		if escalate then
			state = "hunt"
			lastHuntHeard = now
		elseif state == "hunt" and now - lastHuntHeard > Config.MonsterHuntGrace then
			state = "investigate"
		elseif state ~= "hunt" then
			state = "investigate"
		end

		if state ~= "hunt" then
			-- Investigation time starts when the monster actually reaches the
			-- sound. Previously it expired while travelling, then resumed its old
			-- patrol goal, which often looked like it remembered a silent player.
			if distToHeard <= 4.5 then
				if not heard.arrivedAt then
					heard.arrivedAt = now
				end
				if now - (heard.arrivedAt :: number) >= Config.MonsterInvestigateTime then
					heard = nil
					state = "wander"
					wanderGoal = nil
				end
			elseif age > Config.MonsterInvestigateTime + 12 then
				-- Abandon an unreachable sound eventually instead of pursuing it
				-- forever, but never resume a patrol target from before the sound.
				heard = nil
				state = "wander"
				wanderGoal = nil
			else
				heard.arrivedAt = nil
			end
		end
	elseif state ~= "wander" then
		state = "wander"
		wanderGoal = nil
	end

	if state == "hunt" or state == "investigate" then
		targetSpeed = (state == "hunt") and Config.MonsterHuntSpeed or Config.MonsterInvestigateSpeed
		return heard and heard.pos or root.Position
	end

	targetSpeed = Config.MonsterWanderSpeed
	if not wanderGoal or (root.Position - wanderGoal).Magnitude < 8 then
		wanderGoal = nearestNode(root.Position)
	end
	return wanderGoal or root.Position
end

------------------------------------------------------------------- locomotion
local waypoints: { PathWaypoint } = {}
local wpIndex = 1
local lastCompute = 0
local currentGoal = Vector3.zero
local pathObj = PathfindingService:CreatePath(AGENT)
local directFallbackGoal: Vector3? = nil
local navigationParams = RaycastParams.new()
navigationParams.FilterType = Enum.RaycastFilterType.Include
navigationParams.RespectCanCollide = true
local function mapCollisionParams(): RaycastParams
	local map = workspace:FindFirstChild("GeneratedMap")
	navigationParams.FilterDescendantsInstances = if map then {map} else {}
	return navigationParams
end

local function fallbackRoute(goal: Vector3)
	local map = workspace:FindFirstChild("GeneratedMap")
	if map and map:GetAttribute("MapKind") == "Maze" then
		-- Follow the same passage graph that created the walls when navmesh is
		-- still baking. Never steer through the walls to reach a sound.
		local route = MazeLayout.Route(root.Position, goal)
		local fallback: {PathWaypoint} = {}
		for _, position in route do
			table.insert(fallback, PathWaypoint.new(position, Enum.PathWaypointAction.Walk))
		end
		waypoints, wpIndex, directFallbackGoal = fallback, 1, nil
	else
		directFallbackGoal = goal
	end
end

local function recompute(goal: Vector3)
	lastCompute = os.clock()
	currentGoal = goal
	directFallbackGoal = nil
	local ok = pcall(function()
		pathObj:ComputeAsync(root.Position, goal)
	end)
	if ok and pathObj.Status == Enum.PathStatus.Success then
		waypoints = pathObj:GetWaypoints()
		if #waypoints >= 2 then
			wpIndex = 2 -- waypoint 1 is our own position
		else
			-- A successful zero-length path is not a usable route. Keep moving
			-- toward the requested point instead of idling forever.
			waypoints = {}
			wpIndex = 1
			fallbackRoute(goal)
		end
	else
		waypoints = {}
		wpIndex = 1
		-- Pathfinding occasionally has no navmesh ready immediately after the
		-- procedural map is built. The Blind One is moved by CFrame and has no
		-- collisions, so direct steering is a safe temporary fallback. A fresh
		-- path is attempted again on the normal refresh interval.
		fallbackRoute(goal)
	end
end

task.wait(1.5) -- let MapBuilder finish placing nodes
spawnMonster()

-- decision loop: choose a goal, refresh the path only when it's stale
task.spawn(function()
	while true do
		if monster.Parent and humanoid.Health > 0 then
			if #patrolNodes == 0 then
				patrolNodes = gatherNodes()
			end
			pollPlayers()
			local goal = decide()
			local maxAge = (state == "hunt") and 0.4 or 0.9
			local moved = (goal - currentGoal).Magnitude > 6
			local missingRoute = #waypoints == 0 and directFallbackGoal == nil
			local finishedRoute = #waypoints > 0 and wpIndex > #waypoints and directFallbackGoal == nil
			if moved or os.clock() - lastCompute > maxAge or missingRoute or finishedRoute then
				recompute(goal)
			end
		end
		task.wait(0.15)
	end
end)

-- mover: glide the anchored root along the path by CFrame every frame
RunService.Heartbeat:Connect(function(dt)
	local humanMonster = humanBlindOne()
	if spawnReady then
		if humanMonster and monster.Parent then
			monster.Parent = nil
		elseif not humanMonster and not monster.Parent then
			monster.Parent = workspace
			waypoints = {}
			wpIndex = 1
		end
	end
	if humanMonster then
		return
	end
	if not monster.Parent or humanoid.Health <= 0 then
		return
	end
	if photoFrozen then
		monster:SetAttribute("VisualMoveSpeed", 0)
		return
	end
	local wp = waypoints[wpIndex]
	local targetPosition = if wp then wp.Position else directFallbackGoal
	if not targetPosition then
		monster:SetAttribute("VisualMoveSpeed", 0)
		return
	end

	currentSpeed += (targetSpeed - currentSpeed) * math.clamp(dt * 4, 0, 1)

	local target = Vector3.new(targetPosition.X, ROOT_Y, targetPosition.Z)
	local toTarget = target - root.Position
	local flat = Vector3.new(toTarget.X, 0, toTarget.Z)

	if flat.Magnitude < 2.5 then
		if wp then
			wpIndex += 1
			if wpIndex > #waypoints then
				directFallbackGoal = currentGoal
			end
		else
			directFallbackGoal = nil
			if state == "wander" then
				wanderGoal = nil
			end
		end
		return
	end

	local dir = flat.Unit
	monster:SetAttribute("VisualMoveSpeed", currentSpeed)
	local step = dir * math.min(currentSpeed * math.min(dt, 0.1), flat.Magnitude)
	local hit = workspace:Blockcast(CFrame.new(root.Position), Vector3.new(3,5,3), step, mapCollisionParams())
	if hit then
		monster:SetAttribute("VisualMoveSpeed", 0)
		lastCompute = 0
		return
	end
	local newPos = root.Position + step
	local goalRot = CFrame.lookAt(Vector3.zero, dir).Rotation
	local easedRot = root.CFrame.Rotation:Lerp(goalRot, math.clamp(dt * 6, 0, 1))
	monster:PivotTo(CFrame.new(newPos) * easedRot)
end)

-- brief invulnerability right after (re)spawning
local spawnedAt: { [Player]: number } = {}
local function armGrace(player: Player)
	player.CharacterAdded:Connect(function()
		spawnedAt[player] = os.clock()
	end)
	if player.Character then
		spawnedAt[player] = os.clock()
	end
end
for _, p in Players:GetPlayers() do
	armGrace(p)
end
Players.PlayerAdded:Connect(armGrace)
Players.PlayerRemoving:Connect(function(p)
	spawnedAt[p] = nil
end)

-- catch check + dread broadcast
RunService.Heartbeat:Connect(function()
	local humanMonster = humanBlindOne()
	local humanCharacter = humanMonster and humanMonster.Character
	local humanRoot = humanCharacter and humanCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanHumanoid = humanCharacter and humanCharacter:FindFirstChildOfClass("Humanoid")
	if humanMonster then
		Remotes.Dread:FireClient(humanMonster, 0)
	end
	if photoFrozen and not humanMonster then
		for _, player in Players:GetPlayers() do
			Remotes.Dread:FireClient(player, 0)
		end
		return
	end
	if humanMonster and (not humanRoot or not humanHumanoid or humanHumanoid.Health <= 0) then
		for _, player in Players:GetPlayers() do
			if player ~= humanMonster then
				Remotes.Dread:FireClient(player, 0)
			end
		end
		return
	end
	if not humanMonster and not monster.Parent then
		return
	end
	for _, player in Players:GetPlayers() do
		if player == humanMonster or player:GetAttribute("Role") == "BlindOne" then
			continue
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local sourcePosition = if humanRoot then humanRoot.Position else root.Position
			local d = (hrp.Position - sourcePosition).Magnitude
			local graced = os.clock() - (spawnedAt[player] or 0) < Config.SpawnGrace
			if d < Config.MonsterCatchDistance and not graced then
				local blocked = workspace:Raycast(sourcePosition, hrp.Position-sourcePosition, mapCollisionParams())
				if not blocked then catchBindable:Fire(player, humanMonster ~= nil) end
			end
			Remotes.Dread:FireClient(player, math.clamp(1 - d / 45, 0, 1))
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">NoiseService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Tracks every player's 0..100 noise meter and broadcasts positional "noise events"
-- that the monster listens to. Other server scripts emit spikes via the ServerStorage
-- BindableEvent "Noise" :Fire(position, loudness).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

-- Reuse one noise bus when Rojo restarts this script during a playtest.
local noiseBindable = ServerStorage:FindFirstChild("Noise") :: BindableEvent?
if noiseBindable and not noiseBindable:IsA("BindableEvent") then
	noiseBindable:Destroy()
	noiseBindable = nil
end
if not noiseBindable then
	noiseBindable = Instance.new("BindableEvent")
	noiseBindable.Name = "Noise"
	noiseBindable.Parent = ServerStorage
end
for _, child in ServerStorage:GetChildren() do
	if child.Name == "Noise" and child ~= noiseBindable then
		child:Destroy()
	end
end
local noiseEvent = noiseBindable :: BindableEvent

local NOISE_TARGET = {
	idle = Config.NoiseIdle,
	walk = Config.NoiseWalk,
	crouch = Config.NoiseCrouch,
	sprint = Config.NoiseSprint,
}

local MOVE_SPEED = {
	idle = Config.WalkSpeed,
	walk = Config.WalkSpeed,
	crouch = Config.CrouchSpeed,
	sprint = Config.SprintSpeed,
}

type State = { meter: number, move: string, lastStep: number }
local states: { [Player]: State } = {}

local function setupPlayer(player: Player)
	states[player] = { meter = 0, move = "idle", lastStep = 0 }
end
for _, player in Players:GetPlayers() do
	setupPlayer(player)
end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
end)

Remotes.SetMoveState.OnServerEvent:Connect(function(player, move)
	local st = states[player]
	if st and typeof(move) == "string" and NOISE_TARGET[move] ~= nil then
		st.move = move
	end
end)

local broadcast = 0
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	for player, st in states do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then
			st.meter = math.max(0, st.meter - Config.NoiseSmoothing * 6 * dt)
			player:SetAttribute("Noise", st.meter)
			continue
		end
		if player:GetAttribute("Role") == "BlindOne" then
			st.meter = 0
			st.move = "idle"
			player:SetAttribute("Noise", 0)
			if hum.WalkSpeed ~= Config.PlayerBlindOneSpeed then
				hum.WalkSpeed = Config.PlayerBlindOneSpeed
			end
			continue
		end

		-- Humanoid properties are server-authoritative in newer authority modes.
		-- Mirror the client's validated movement state so WalkSpeed cannot be
		-- discarded by replication after the local controller applies it.
		local desiredSpeed = MOVE_SPEED[st.move] or Config.WalkSpeed
		if hum.WalkSpeed ~= desiredSpeed then
			hum.WalkSpeed = desiredSpeed
		end

		local vel = hrp.AssemblyLinearVelocity
		local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local moving = speed > 1.5
		-- target noise scales with how fast you're actually going, not just the key you hold
		local speedFactor = math.clamp(speed / Config.WalkSpeed, 0, 1.3)
		local target = (NOISE_TARGET[st.move] or 0) * (moving and speedFactor or 0)
		-- Objectives such as repairing a relay or cranking the escape gate are
		-- deliberately loud even when the survivor is standing still. GameService
		-- supplies a short override so human Blind Ones also see that survivor's
		-- sound silhouette through the forest and buildings.
		local overrideUntil = player:GetAttribute("NoiseOverrideUntil")
		local overrideLevel = player:GetAttribute("NoiseOverrideLevel")
		if typeof(overrideUntil) == "number" and typeof(overrideLevel) == "number" and os.clock() < overrideUntil then
			target = math.max(target, overrideLevel)
		end

		if st.meter < target then
			st.meter = math.min(target, st.meter + Config.NoiseSmoothing * 3 * dt)
		else
			st.meter = math.max(target, st.meter - Config.NoiseSmoothing * dt)
		end
		player:SetAttribute("Noise", st.meter)

		-- positional footstep blips while moving
		if moving and st.meter > 8 then
			local interval = Config.FootstepInterval * (st.move == "sprint" and 0.6 or 1)
			if now - st.lastStep >= interval then
				st.lastStep = now
				noiseEvent:Fire(hrp.Position, st.meter)
			end
		end
	end

	broadcast += dt
	if broadcast >= 0.1 then
		broadcast = 0
		for player, st in states do
			Remotes.NoiseMeter:FireClient(player, math.floor(st.meter + 0.5))
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">RoleService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Solo servers use the AI. With two or more players, one player is selected as
-- The Blind One and the remaining players stay survivors.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local JumpPolicy = require(ReplicatedStorage:WaitForChild("JumpPolicy"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local MonsterAppearance = require(script.Parent:WaitForChild("MonsterAppearance"))

local rng = Random.new()
local ORIGINAL_ANIMATE_ENABLED = "BlindOneOriginalAnimateEnabled"

local function farMonsterSpawn(): Vector3?
	local generatedMap = workspace:FindFirstChild("GeneratedMap")
	local spawnPart = generatedMap and generatedMap:FindFirstChild("Spawn")
	local origin = if spawnPart and spawnPart:IsA("BasePart") then spawnPart.Position else Vector3.zero
	local best: Vector3? = nil
	local bestDistance = -1
	for _, node in CollectionService:GetTagged("PatrolNode") do
		if node:IsA("BasePart") then
			local distance = (node.Position - origin).Magnitude
			if distance > bestDistance then
				bestDistance = distance
				best = node.Position
			end
		end
	end
	return best
end

local function moveMonsterToFarSpawn(player: Player, character: Model)
	for _ = 1, 30 do
		if player.Character ~= character or player:GetAttribute("Role") ~= "BlindOne" then
			return
		end
		local position = farMonsterSpawn()
		if position then
			character:PivotTo(CFrame.new(position + Vector3.new(0, 3.5, 0)))
			return
		end
		task.wait(0.2)
	end
end

local function clearMonsterVisual(character: Model)
	MonsterAppearance.Clear(character)
end

local function addMonsterVisual(character: Model)
	MonsterAppearance.Apply(character)
end

local function styleCharacter(player: Player, character: Model, moveToMonsterSpawn: boolean)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animate = character:FindFirstChild("Animate")
	if humanoid then
		JumpPolicy.Apply(humanoid, player:GetAttribute("Role") ~= "BlindOne")
	end
	if player:GetAttribute("Role") == "BlindOne" then
		if animate and animate:IsA("LocalScript") then
			if animate:GetAttribute(ORIGINAL_ANIMATE_ENABLED) == nil then
				animate:SetAttribute(ORIGINAL_ANIMATE_ENABLED, animate.Enabled)
			end
			-- The monster has its own procedural limp. Leaving Roblox's stock walk
			-- active makes the two gaits fight and the normal walk wins remotely.
			animate.Enabled = false
		end
		addMonsterVisual(character)
		if humanoid then
			humanoid.WalkSpeed = Config.PlayerBlindOneSpeed
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
		if moveToMonsterSpawn then
			task.spawn(moveMonsterToFarSpawn, player, character)
		end
	else
		if animate and animate:IsA("LocalScript") then
			local originalEnabled = animate:GetAttribute(ORIGINAL_ANIMATE_ENABLED)
			if typeof(originalEnabled) == "boolean" then
				animate.Enabled = originalEnabled
				animate:SetAttribute(ORIGINAL_ANIMATE_ENABLED, nil)
			end
		end
		clearMonsterVisual(character)
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
		end
	end
end

local function setRole(player: Player, role: string)
	local changed = player:GetAttribute("Role") ~= role
	player:SetAttribute("Role", role)
	if changed then
		player:SetAttribute("HasKey", false)
	end
	local character = player.Character
	if character then
		styleCharacter(player, character, changed and role == "BlindOne")
	end
	if changed then
		if role == "BlindOne" then
			Remotes.Objective:FireClient(player, "YOU ARE THE BLIND ONE — follow sound and catch every survivor.")
		else
			local map = workspace:FindFirstChild("GeneratedMap")
			local active = if map then map:GetAttribute("MechanismsActive") else 0
			local total = if map then map:GetAttribute("MechanismsTotal") else 3
			Remotes.Objective:FireClient(player, ("Restore the gate mechanisms (%d/%d). Stay quiet."):format(
				if typeof(active) == "number" then active else 0,
				if typeof(total) == "number" then total else 3
			))
		end
	end
end

local function refreshRoles()
	local players = Players:GetPlayers()
	if not Config.PlayerBlindOneEnabled or #players < 2 then
		for _, player in players do
			setRole(player, "Survivor")
		end
		return
	end

	local chosen: Player? = nil
	for _, player in players do
		if player:GetAttribute("Role") == "BlindOne" then
			chosen = player
			break
		end
	end
	if not chosen then
		chosen = players[rng:NextInteger(1, #players)]
	end
	for _, player in players do
		setRole(player, if player == chosen then "BlindOne" else "Survivor")
	end
end

local function setupPlayer(player: Player)
	if player:GetAttribute("Role") == nil then
		player:SetAttribute("Role", "Survivor")
	end
	player.CharacterAdded:Connect(function(character)
		task.wait(0.1)
		styleCharacter(player, character, player:GetAttribute("Role") == "BlindOne")
	end)
	player.CharacterAppearanceLoaded:Connect(function(character)
		-- Catalog accessories can arrive after CharacterAdded. Reapply once Roblox
		-- finishes loading them so the personal avatar never leaks through the skin.
		if player.Character == character and player:GetAttribute("Role") == "BlindOne" then
			addMonsterVisual(character)
		end
	end)
end

for _, player in Players:GetPlayers() do
	setupPlayer(player)
end
Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
	task.defer(refreshRoles)
end)
Players.PlayerRemoving:Connect(function()
	task.delay(0.15, refreshRoles)
end)

task.defer(refreshRoles)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">ThrowableService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Rocks you can pick up (E) and throw (click). A thrown rock makes a loud noise where
-- it lands -- the core tool for pulling the monster away from you.
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local noiseBindable = ServerStorage:WaitForChild("Noise") :: BindableEvent

local held: { [Player]: number } = {}

local function setHeld(player: Player, n: number)
	held[player] = math.clamp(n, 0, Config.MaxThrowables)
	player:SetAttribute("HeldBalls", held[player])
	Remotes.HeldCount:FireClient(player, held[player])
end

local function setupPlayer(player: Player)
	held[player] = 0
	player.CharacterAdded:Connect(function()
		setHeld(player, Config.StartThrowables)
	end)
	if player.Character then
		setHeld(player, Config.StartThrowables)
	end
end

for _, player in Players:GetPlayers() do
	setupPlayer(player)
end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	held[player] = nil
end)

local function makeRock(pos: Vector3): BasePart
	local rock = Instance.new("Part")
	rock.Name = "Rock"
	rock.Shape = Enum.PartType.Ball
	rock.Size = Vector3.new(0.92, 0.92, 0.92)
	rock.Color = Color3.fromRGB(58, 55, 49)
	rock.Material = Enum.Material.Rock
	rock.Position = pos
	rock:SetAttribute("SessionThrownBall", true)
	rock.Parent = workspace
	CollectionService:AddTag(rock, "Throwable")
	-- A missed throw should never build an endless pile during a long test server.
	Debris:AddItem(rock, 45)
	return rock
end

-- Also covers Rojo restarting this script during an active Studio server.
for _, oldRock in CollectionService:GetTagged("Throwable") do
	if oldRock:GetAttribute("SessionThrownBall") == true then
		oldRock:Destroy()
	end
end

Remotes.Pickup.OnServerEvent:Connect(function(player, rock, cameraOrigin, cameraLook)
	if player:GetAttribute("Role") == "BlindOne" then
		return
	end
	if typeof(rock) ~= "Instance" or not rock:IsA("BasePart") or not rock:HasTag("Throwable") then
		return
	end
	if (held[player] or 0) >= Config.MaxThrowables then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not hrp or not head or typeof(cameraOrigin) ~= "Vector3" or typeof(cameraLook) ~= "Vector3" then
		return
	end
	local toRock = rock.Position - cameraOrigin
	if (hrp.Position - rock.Position).Magnitude > 12 or (cameraOrigin - head.Position).Magnitude > 6 or toRock.Magnitude < 0.1 then
		return
	end
	if cameraLook.Magnitude < 0.9 or cameraLook.Unit:Dot(toRock.Unit) < 0.975 then
		return
	end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char }
	rayParams.IgnoreWater = true
	local hit = workspace:Raycast(cameraOrigin, toRock, rayParams)
	if not hit or hit.Instance ~= rock then
		return
	end
	rock:Destroy()
	setHeld(player, (held[player] or 0) + 1)
end)

Remotes.Throw.OnServerEvent:Connect(function(player, direction)
	if player:GetAttribute("Role") == "BlindOne" then
		return
	end
	if typeof(direction) ~= "Vector3" or (held[player] or 0) <= 0 then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return
	end
	setHeld(player, (held[player] or 0) - 1)

	local dir = direction.Unit
	local rock = makeRock(hrp.Position + dir * 3 + Vector3.new(0, 2, 0))
	-- The player-controlled Blind One sees this as the same anonymous human
	-- sound silhouette used for survivors, never as a visibly identifiable rock.
	rock:SetAttribute("BlindOneDecoy", true)
	rock:SetAttribute("BlindOneDecoyUntil", workspace:GetServerTimeNow() + 5)
	rock:SetNetworkOwner(nil)
	rock.AssemblyLinearVelocity = dir * 90 + Vector3.new(0, 18, 0)

	local landed = false
	local function onHit(other: BasePart)
		if landed then
			return
		end
		if other:IsDescendantOf(char) then
			return
		end
		landed = true
		rock:SetAttribute("BlindOneDecoyUntil", workspace:GetServerTimeNow() + 3.2)
		noiseBindable:Fire(rock.Position, Config.ThrowImpactNoise)
	end
	rock.Touched:Connect(onHit)
	task.delay(4, function()
		if not landed then
			landed = true
			rock:SetAttribute("BlindOneDecoyUntil", workspace:GetServerTimeNow() + 3.2)
			noiseBindable:Fire(rock.Position, Config.ThrowImpactNoise * 0.6)
		end
	end)
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="16">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
    </Item>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">BlindOneController</string>
          <string name="Source"><![CDATA[--!strict
-- Client presentation for a player-controlled Blind One. The world is heavily
-- desaturated and noisy survivors appear as short-lived sound silhouettes.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local player = Players.LocalPlayer

local oldVision = Lighting:FindFirstChild("LocalBlindOneVision")
if oldVision then
	oldVision:Destroy()
end
local vision = Instance.new("ColorCorrectionEffect")
vision.Name = "LocalBlindOneVision"
-- Map hiding supplies blindness. Crushing all scene colors also crushed the
-- cyan surface echoes into dark reddish pixels.
vision.Brightness = 0
vision.Contrast = 0
vision.Saturation = 0
vision.TintColor = Color3.new(1, 1, 1)
vision.Enabled = false
vision.Parent = Lighting

-- MapBuilder intentionally disables old post effects. This local bloom is
-- deterministic and lets the monster's Neon eye cores produce a real soft halo
-- on every client without changing the server's darkness or exposure.
local oldEyeBloom = Lighting:FindFirstChild("LocalMonsterEyeBloom")
if oldEyeBloom then
	oldEyeBloom:Destroy()
end
local eyeBloom = Instance.new("BloomEffect")
eyeBloom.Name = "LocalMonsterEyeBloom"
eyeBloom.Intensity = 1.45
eyeBloom.Size = 18
eyeBloom.Threshold = 0.82
eyeBloom.Enabled = true
eyeBloom.Parent = Lighting

local gui = Instance.new("ScreenGui")
gui.Name = "BlindOneRoleHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local title = Instance.new("TextLabel")
title.AnchorPoint = Vector2.new(0.5, 0)
title.Position = UDim2.new(0.5, 0, 0, 74)
title.Size = UDim2.fromOffset(520, 58)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.Text = "THE BLIND ONE"
title.TextSize = 25
title.TextColor3 = Color3.fromRGB(210, 225, 232)
title.TextStrokeColor3 = Color3.new(0, 0, 0)
title.TextStrokeTransparency = 0.35
title.Parent = gui

local hint = Instance.new("TextLabel")
hint.AnchorPoint = Vector2.new(0.5, 0)
hint.Position = UDim2.new(0.5, 0, 0, 108)
hint.Size = UDim2.fromOffset(620, 28)
hint.BackgroundTransparency = 1
hint.Font = Enum.Font.GothamMedium
hint.Text = "Noisy survivors leave bright silhouettes. Get close to catch them."
hint.TextSize = 14
hint.TextColor3 = Color3.fromRGB(155, 175, 185)
hint.TextStrokeTransparency = 0.55
hint.Parent = gui

local senseLight = Instance.new("PointLight")
senseLight.Name = "BlindSenseGlow"
senseLight.Color = Color3.fromRGB(105, 130, 138)
senseLight.Brightness = 3.1
senseLight.Range = 10
senseLight.Shadows = false
senseLight.Enabled = false

-- Direct surface samples make nearby geometry readable even when Lighting's
-- ambient/fog settings swallow local lights. The fixed pool is local-only and
-- allocation-free during play, so it cannot create the clone/performance issue.
local oldGeometrySense = workspace:FindFirstChild("LocalBlindSenseGeometry")
if oldGeometrySense then
	oldGeometrySense:Destroy()
end
local geometrySense = Instance.new("Folder")
geometrySense.Name = "LocalBlindSenseGeometry"
geometrySense.Parent = workspace

local oldSoundFigures = workspace:FindFirstChild("LocalBlindSoundFigures")
if oldSoundFigures then
	oldSoundFigures:Destroy()
end
local soundFigures = Instance.new("Folder")
soundFigures.Name = "LocalBlindSoundFigures"
soundFigures.Parent = workspace

local SENSE_COLUMNS = 7
local SENSE_ROWS = 5
local SENSE_RANGE = 12
local senseDots: { Part } = {}
for index = 1, SENSE_COLUMNS * SENSE_ROWS do
	local dot = Instance.new("Part")
	dot.Name = "SurfaceEcho"
	dot.Shape = Enum.PartType.Ball
	dot.Size = Vector3.one * 0.2
	dot.Color = Color3.fromRGB(125, 155, 165)
	dot.Material = Enum.Material.Neon
	dot.Anchored = true
	dot.CanCollide = false
	dot.CanTouch = false
	dot.CanQuery = false
	dot.CastShadow = false
	dot.Transparency = 1
	dot.Parent = geometrySense
	senseDots[index] = dot
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true
local nextGeometrySenseAt = 0

local function hideGeometrySense()
	for _, dot in senseDots do
		dot.Transparency = 1
	end
end

local function updateGeometrySense(camera: Camera, ownCharacter: Model, now: number)
	if now < nextGeometrySenseAt then
		return
	end
	nextGeometrySenseAt = now + 0.065

	local excluded: { Instance } = { ownCharacter, geometrySense, soundFigures }
	for _, otherPlayer in Players:GetPlayers() do
		if otherPlayer.Character and otherPlayer.Character ~= ownCharacter then
			table.insert(excluded, otherPlayer.Character)
		end
	end
	raycastParams.FilterDescendantsInstances = excluded

	local viewport = camera.ViewportSize
	local dotIndex = 0
	for row = 0, SENSE_ROWS - 1 do
		for column = 0, SENSE_COLUMNS - 1 do
			dotIndex += 1
			local screenX = viewport.X * (0.06 + 0.88 * column / (SENSE_COLUMNS - 1))
			local screenY = viewport.Y * (0.24 + 0.72 * row / (SENSE_ROWS - 1))
			local ray = camera:ViewportPointToRay(screenX, screenY)
			local result = workspace:Raycast(ray.Origin, ray.Direction * SENSE_RANGE, raycastParams)
			local dot = senseDots[dotIndex]
			if result then
				local distance = (result.Position - ray.Origin).Magnitude
				local closeness = 1 - math.clamp(distance / SENSE_RANGE, 0, 1)
				local size = 0.16 + closeness * 0.2
				dot.Size = Vector3.one * size
				dot.CFrame = CFrame.new(result.Position + result.Normal * 0.035)
				dot.Transparency = 0.24 + (1 - closeness) * 0.54
			else
				dot.Transparency = 1
			end
		end
	end
end

local lastRole = ""
local roleShownAt = 0
local NEAR_ECHO_ENTER = 42
local NEAR_ECHO_EXIT = 50 -- hysteresis avoids flickering at the transition

type EchoFigure = {
	model: Model,
	highlight: Highlight,
	billboard: BillboardGui,
	strokes: { UIStroke },
	parts: { [string]: Part },
	phase: number,
	position: Vector3?,
	direction: Vector3?,
	near: boolean,
}

local survivorFigures: { [Player]: EchoFigure } = {}
local rockFigures: { [BasePart]: EchoFigure } = {}
local hiddenParts: { [BasePart]: number } = {}
local hiddenNameplates: { [Humanoid]: Enum.HumanoidDisplayDistanceType } = {}
local hiddenDecoyBalls: { [BasePart]: number } = {}
local ownVisualParts: { [BasePart]: number } = {}
local ownVisualLights: { [Light]: boolean } = {}
local ownVisualHighlights: { [Highlight]: boolean } = {}

local function echoPart(model: Model, name: string, size: Vector3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Shape = shape or Enum.PartType.Block
	part.Color = Color3.fromRGB(103, 177, 217)
	part.Material = Enum.Material.Neon
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Parent = model
	return part
end

local function newEchoFigure(name: string): EchoFigure
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = soundFigures
	local parts = {
		Torso = echoPart(model, "Torso", Vector3.new(1.3, 1.65, 0.62)),
		Head = echoPart(model, "Head", Vector3.new(0.82, 0.82, 0.82), Enum.PartType.Ball),
		LeftArm = echoPart(model, "LeftArm", Vector3.new(0.42, 1.62, 0.48)),
		RightArm = echoPart(model, "RightArm", Vector3.new(0.42, 1.62, 0.48)),
		LeftLeg = echoPart(model, "LeftLeg", Vector3.new(0.5, 1.72, 0.55)),
		RightLeg = echoPart(model, "RightLeg", Vector3.new(0.5, 1.72, 0.55)),
	}
	local highlight = Instance.new("Highlight")
	highlight.Name = "LocalSoundSilhouette"
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = Color3.fromRGB(68, 143, 193)
	highlight.OutlineColor = Color3.fromRGB(125, 205, 250)
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 1
	highlight.Enabled = false
	highlight.Adornee = model
	highlight.Parent = model

	-- Highlights are not dependable through every opaque Roblox material. This
	-- anonymous outline is drawn in screen space over the echo's torso, so sound
	-- is readable through walls without revealing the survivor's real avatar.
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ThroughWallSoundOutline"
	billboard.Adornee = parts.Torso
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	-- Sound is global, but the marker stays deliberately small so distance is
	-- readable instead of turning every survivor into a giant HUD target.
	billboard.MaxDistance = 100000
	billboard.Size = UDim2.fromOffset(28, 44)
	billboard.Enabled = false
	billboard.Parent = parts.Torso

	local strokes: { UIStroke } = {}
	local function outlinePiece(
		pieceName: string,
		position: UDim2,
		size: UDim2,
		rotation: number,
		round: boolean
	)
		local piece = Instance.new("Frame")
		piece.Name = pieceName
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = position
		piece.Size = size
		piece.Rotation = rotation
		piece.BackgroundTransparency = 1
		piece.Parent = billboard
		if round then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = piece
		end
		local stroke = Instance.new("UIStroke")
		stroke.Name = "SoundStroke"
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = Color3.fromRGB(225, 244, 255)
		stroke.Thickness = 1.35
		stroke.Transparency = 1
		stroke.Parent = piece
		table.insert(strokes, stroke)
	end

	outlinePiece("Head", UDim2.fromScale(0.5, 0.12), UDim2.fromScale(0.31, 0.2), 0, true)
	outlinePiece("Torso", UDim2.fromScale(0.5, 0.42), UDim2.fromScale(0.45, 0.36), 0, false)
	outlinePiece("LeftArm", UDim2.fromScale(0.25, 0.45), UDim2.fromScale(0.15, 0.44), 8, true)
	outlinePiece("RightArm", UDim2.fromScale(0.75, 0.45), UDim2.fromScale(0.15, 0.44), -8, true)
	outlinePiece("LeftLeg", UDim2.fromScale(0.39, 0.78), UDim2.fromScale(0.17, 0.42), 3, true)
	outlinePiece("RightLeg", UDim2.fromScale(0.61, 0.78), UDim2.fromScale(0.17, 0.42), -3, true)

	return {
		model = model,
		highlight = highlight,
		billboard = billboard,
		strokes = strokes,
		parts = parts,
		phase = 0,
		near = false,
	}
end

local function survivorFigure(target: Player): EchoFigure
	local existing = survivorFigures[target]
	if existing then
		return existing
	end
	local figure = newEchoFigure("AnonymousSurvivorEcho")
	survivorFigures[target] = figure
	return figure
end

local function rockFigure(rock: BasePart): EchoFigure
	local existing = rockFigures[rock]
	if existing then
		return existing
	end
	local figure = newEchoFigure("AnonymousDecoyEcho")
	rockFigures[rock] = figure
	return figure
end


local function poseEcho(
	figure: EchoFigure,
	center: Vector3,
	direction: Vector3,
	speed: number,
	strength: number,
	dt: number,
	forceMotion: boolean,
	distance: number
)
	figure.near = if figure.near then distance < NEAR_ECHO_EXIT else distance <= NEAR_ECHO_ENTER
	for _, part in figure.parts do
		-- Highlight stops rendering reliably on almost-fully-transparent parts.
		-- A dim Neon body guarantees a readable anonymous echo in the darkness;
		-- the real survivor avatar remains locally hidden.
		part.Transparency = if figure.near then 0.82 else 1
	end
	local flatDirection = Vector3.new(direction.X, 0, direction.Z)
	if flatDirection.Magnitude < 0.01 then
		flatDirection = Vector3.new(0, 0, -1)
	else
		flatDirection = flatDirection.Unit
	end
	local base = CFrame.lookAt(center, center + flatDirection)
	local motionWeight = if forceMotion then 0.9 else math.clamp(speed / 8, 0, 1)
	if motionWeight > 0.02 then
		figure.phase += dt * (3.8 + math.min(speed, 20) * 0.22)
	end
	local swing = math.sin(figure.phase) * math.rad(24) * motionWeight
	local bob = math.abs(math.sin(figure.phase)) * 0.08 * motionWeight
	figure.parts.Torso.CFrame = base * CFrame.new(0, bob, 0)
	figure.parts.Head.CFrame = base * CFrame.new(0, 1.36 + bob, 0)
	figure.parts.LeftArm.CFrame = base * CFrame.new(-0.91, 0.02 + bob, 0) * CFrame.Angles(swing, 0, 0)
	figure.parts.RightArm.CFrame = base * CFrame.new(0.91, 0.02 + bob, 0) * CFrame.Angles(-swing, 0, 0)
	figure.parts.LeftLeg.CFrame = base * CFrame.new(-0.37, -1.67 + bob, 0) * CFrame.Angles(-swing, 0, 0)
	figure.parts.RightLeg.CFrame = base * CFrame.new(0.37, -1.67 + bob, 0) * CFrame.Angles(swing, 0, 0)
	figure.highlight.Enabled = figure.near and strength > 0.02
	figure.highlight.FillTransparency = 0.93 - strength * 0.2
	figure.highlight.OutlineTransparency = 0.62 - strength * 0.58
	figure.billboard.Enabled = not figure.near and strength > 0.02
	local strokeTransparency = math.clamp(0.76 - strength * 0.72, 0.04, 0.72)
	for _, stroke in figure.strokes do
		stroke.Transparency = strokeTransparency
	end
end

local function hideEcho(figure: EchoFigure)
	figure.near = false
	figure.highlight.Enabled = false
	figure.billboard.Enabled = false
	for _, part in figure.parts do
		part.Transparency = 1
	end
end

local function hideOwnBlindOneVisual(character: Model?, hidden: boolean)
	local visual = character and character:FindFirstChild("BlindOneVisual")
	if hidden and visual then
		for _, descendant in visual:GetDescendants() do
			if descendant:IsA("BasePart") then
				if ownVisualParts[descendant] == nil then
					ownVisualParts[descendant] = descendant.LocalTransparencyModifier
				end
				descendant.LocalTransparencyModifier = 1
			elseif descendant:IsA("Light") then
				if ownVisualLights[descendant] == nil then
					ownVisualLights[descendant] = descendant.Enabled
				end
				descendant.Enabled = false
			elseif descendant:IsA("Highlight") then
				if ownVisualHighlights[descendant] == nil then
					ownVisualHighlights[descendant] = descendant.Enabled
				end
				descendant.Enabled = false
			end
		end
		return
	end
	for part, original in ownVisualParts do
		if part.Parent then
			part.LocalTransparencyModifier = original
		end
		ownVisualParts[part] = nil
	end
	for light, original in ownVisualLights do
		if light.Parent then
			light.Enabled = original
		end
		ownVisualLights[light] = nil
	end
	for highlight, original in ownVisualHighlights do
		if highlight.Parent then
			highlight.Enabled = original
		end
		ownVisualHighlights[highlight] = nil
	end
end

local function hideActualCharacter(character: Model, hidden: boolean)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if hidden then
			if hiddenNameplates[humanoid] == nil then
				hiddenNameplates[humanoid] = humanoid.DisplayDistanceType
			end
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		elseif hiddenNameplates[humanoid] ~= nil then
			humanoid.DisplayDistanceType = hiddenNameplates[humanoid]
			hiddenNameplates[humanoid] = nil
		end
	end
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			if hidden then
				if hiddenParts[descendant] == nil then
					hiddenParts[descendant] = descendant.LocalTransparencyModifier
				end
				descendant.LocalTransparencyModifier = 1
			elseif hiddenParts[descendant] ~= nil then
				descendant.LocalTransparencyModifier = hiddenParts[descendant]
				hiddenParts[descendant] = nil
			end
		end
	end
end

-- Blindness must not depend on how bright the map happens to be. Hide the
-- generated world locally while keeping its collision/query geometry intact;
-- the close-range surface echoes can still raycast against invisible walls.
local hiddenMapParts: { [BasePart]: number } = {}
local hiddenMapEffects: { [Instance]: boolean } = {}
local hiddenMapTextures: { [Decal]: number } = {}
local savedVisionFog: {color: Color3, start: number, finish: number}? = nil
local pausedGrades: { [PostEffect]: boolean } = {}
local hiddenMap: Instance? = nil
local mapDescendantConnection: RBXScriptConnection? = nil

local function hideMapDescendant(descendant: Instance)
	if descendant:IsA("BasePart") then
		if hiddenMapParts[descendant] == nil then
			hiddenMapParts[descendant] = descendant.LocalTransparencyModifier
		end
		descendant.LocalTransparencyModifier = 1
	elseif descendant:IsA("SurfaceGui") or descendant:IsA("BillboardGui")
		or descendant:IsA("Light") or descendant:IsA("ParticleEmitter")
		or descendant:IsA("Beam") or descendant:IsA("Highlight") then
		hiddenMapEffects[descendant] = (descendant :: any).Enabled
		(descendant :: any).Enabled = false
	elseif descendant:IsA("Decal") then
		hiddenMapTextures[descendant] = descendant.Transparency
		descendant.Transparency = 1
	end
end

local function restoreHiddenMap()
	if mapDescendantConnection then
		mapDescendantConnection:Disconnect()
		mapDescendantConnection = nil
	end
	for mapPart, original in hiddenMapParts do
		if mapPart.Parent then
			mapPart.LocalTransparencyModifier = original
		end
		hiddenMapParts[mapPart] = nil
	end
	hiddenMap = nil
	for effect, enabled in hiddenMapEffects do
		if effect.Parent then (effect :: any).Enabled = enabled end
		hiddenMapEffects[effect] = nil
	end
	for texture, transparency in hiddenMapTextures do
		if texture.Parent then texture.Transparency = transparency end
		hiddenMapTextures[texture] = nil
	end
end

local function setMapBlindness(enabled: boolean)
	if not enabled then
		if savedVisionFog then
			Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = savedVisionFog.color, savedVisionFog.start, savedVisionFog.finish
			savedVisionFog = nil
			for effect, wasEnabled in pausedGrades do
				if effect.Parent then effect.Enabled = wasEnabled end
				pausedGrades[effect] = nil
			end
		end
		if hiddenMap then
			restoreHiddenMap()
		end
		return
	end
	if not savedVisionFog then
		savedVisionFog = {color = Lighting.FogColor, start = Lighting.FogStart, finish = Lighting.FogEnd}
	end
	-- The sky and hidden map stay black; the blue echoes retain their own color.
	Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.new(), 100000, 100001
	for _, effect in Lighting:GetChildren() do
		if effect:IsA("PostEffect") and effect ~= vision then
			if pausedGrades[effect] == nil then pausedGrades[effect] = effect.Enabled end
			effect.Enabled = false
		end
	end
	local currentMap = Workspace:FindFirstChild("GeneratedMap")
	if currentMap == hiddenMap then
		return
	end
	restoreHiddenMap()
	if not currentMap then
		return
	end
	hiddenMap = currentMap
	for _, descendant in currentMap:GetDescendants() do
		hideMapDescendant(descendant)
	end
	mapDescendantConnection = currentMap.DescendantAdded:Connect(hideMapDescendant)
end

Players.PlayerRemoving:Connect(function(target)
	local figure = survivorFigures[target]
	if figure then
		figure.model:Destroy()
	end
	survivorFigures[target] = nil
end)

RunService.RenderStepped:Connect(function(dt)
	local roleValue = player:GetAttribute("Role")
	local role = if typeof(roleValue) == "string" then roleValue else ""
	local isBlindOne = role == "BlindOne"
	local now = os.clock()
	if role ~= "" and role ~= lastRole then
		lastRole = role
		roleShownAt = now
		if isBlindOne then
			title.Text = "YOU ARE THE BLIND ONE"
			title.TextColor3 = Color3.fromRGB(210, 225, 232)
			hint.Text = "Follow bright sound silhouettes • Get close to catch survivors • You carry no light"
			hint.TextColor3 = Color3.fromRGB(155, 185, 200)
		else
			title.Text = "YOU ARE A SURVIVOR"
			title.TextColor3 = Color3.fromRGB(220, 235, 215)
			hint.Text = "Hold Ctrl to crouch • Shift to sprint • E picks up rocks • Click throws them"
			hint.TextColor3 = Color3.fromRGB(170, 195, 165)
		end
	end
	vision.Enabled = isBlindOne
	setMapBlindness(isBlindOne)
	gui.Enabled = role ~= "" and now - roleShownAt < 8
	local ownCharacter = player.Character
	local ownRoot = ownCharacter and ownCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
	-- The monster skin is deliberately huge and textured, but those same meshes
	-- must not sit inside the local first-person camera. This is client-only.
	hideOwnBlindOneVisual(ownCharacter, isBlindOne)
	if isBlindOne and ownRoot then
		if senseLight.Parent ~= ownRoot then
			senseLight.Parent = ownRoot
		end
		senseLight.Enabled = true
		-- A bright but tiny local bubble reveals only the floor and walls within a
		-- few steps. It prevents blind wall-bumping without becoming normal vision.
		senseLight.Brightness = 3.1 + math.sin(now * 2.4) * 0.16
		local camera = workspace.CurrentCamera
		if camera and ownCharacter then
			updateGeometrySense(camera, ownCharacter, now)
		end
	else
		senseLight.Enabled = false
		senseLight.Parent = nil
		hideGeometrySense()
	end

	for _, target in Players:GetPlayers() do
		if target == player then
			continue
		end
		local figure = survivorFigure(target)
		local character = target.Character
		if character then
			hideActualCharacter(character, isBlindOne)
		end
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local noiseValue = target:GetAttribute("Noise")
		local noise = if typeof(noiseValue) == "number" then noiseValue else 0
		local audible = false
		local strength = 0
		if isBlindOne and ownRoot and root and humanoid and humanoid.Health > 0
			and target:GetAttribute("Role") ~= "BlindOne" and noise >= Config.MonsterHearingFloor then
			-- The Blind One hears qualifying survivor noise anywhere on the map.
			-- Distance never suppresses the echo; silence is the only way to vanish.
			audible = true
			local loudness = math.clamp(noise / Config.NoiseWalk, 0.45, 1)
			strength = math.clamp(loudness, 0, 1)
		end
		-- No after-image: once the survivor's noise falls below the hearing floor,
		-- the outline vanishes with the meter instead of leaking their position.
		local shownStrength = if audible then strength else 0
		if isBlindOne and root and shownStrength > 0.02 then
			local velocity = root.AssemblyLinearVelocity
			local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			poseEcho(figure, root.Position, root.CFrame.LookVector, speed, shownStrength, dt, false,
				if ownRoot then (root.Position-ownRoot.Position).Magnitude else math.huge)
		else
			hideEcho(figure)
		end
	end

	-- A thrown rock is deliberately indistinguishable from a survivor echo. The
	-- projectile may travel at 90 studs/sec, but its fake person is capped at a
	-- believable running speed and projected onto the floor.
	local seenRocks: { [BasePart]: boolean } = {}
	local serverNow = Workspace:GetServerTimeNow()
	local rockGroundParams = RaycastParams.new()
	rockGroundParams.FilterType = Enum.RaycastFilterType.Exclude
	rockGroundParams.IgnoreWater = true
	for _, tagged in CollectionService:GetTagged("Throwable") do
		if not tagged:IsA("BasePart") or tagged:GetAttribute("BlindOneDecoy") ~= true then
			continue
		end
		local untilValue = tagged:GetAttribute("BlindOneDecoyUntil")
		if typeof(untilValue) ~= "number" or untilValue <= serverNow then
			continue
		end
		seenRocks[tagged] = true
		local figure = rockFigure(tagged)
		if isBlindOne then
			if hiddenDecoyBalls[tagged] == nil then
				hiddenDecoyBalls[tagged] = tagged.LocalTransparencyModifier
			end
			tagged.LocalTransparencyModifier = 1
		elseif hiddenDecoyBalls[tagged] ~= nil then
			tagged.LocalTransparencyModifier = hiddenDecoyBalls[tagged]
			hiddenDecoyBalls[tagged] = nil
		end
		local strength = 0
		if isBlindOne and ownRoot then
			strength = math.clamp((untilValue - serverNow) / 1.2, 0, 1)
		end
		if strength > 0.02 then
			local velocity = tagged.AssemblyLinearVelocity
			local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
			local excluded: { Instance } = { tagged, soundFigures, geometrySense }
			if ownCharacter then
				table.insert(excluded, ownCharacter)
			end
			rockGroundParams.FilterDescendantsInstances = excluded
			local groundHit = workspace:Raycast(tagged.Position + Vector3.new(0, 5, 0), Vector3.new(0, -35, 0), rockGroundParams)
			local desiredPosition = if groundHit
				then Vector3.new(tagged.Position.X, groundHit.Position.Y + 2.55, tagged.Position.Z)
				else tagged.Position + Vector3.new(0, 2.55, 0)
			if not figure.position then
				figure.position = desiredPosition
			end
			local currentPosition = figure.position :: Vector3
			local flatDelta = Vector3.new(desiredPosition.X - currentPosition.X, 0, desiredPosition.Z - currentPosition.Z)
			local fakeRunSpeed = math.min(Config.SprintSpeed - 1, 16)
			local moving = flatDelta.Magnitude > 0.08
			local direction = figure.direction or tagged.CFrame.LookVector
			if moving then
				direction = flatDelta.Unit
				local step = math.min(flatDelta.Magnitude, fakeRunSpeed * dt)
				currentPosition += direction * step
			end
			currentPosition = Vector3.new(
				currentPosition.X,
				currentPosition.Y + (desiredPosition.Y - currentPosition.Y) * math.min(1, dt * 10),
				currentPosition.Z
			)
			figure.position = currentPosition
			figure.direction = direction
			poseEcho(
				figure,
				currentPosition,
				direction,
				if moving then fakeRunSpeed else math.min(flatVelocity.Magnitude, 3),
				strength,
				dt,
				moving,
				if ownRoot then (currentPosition-ownRoot.Position).Magnitude else math.huge
			)
		else
			hideEcho(figure)
		end
	end
	for rock, figure in rockFigures do
		if not seenRocks[rock] or not rock.Parent then
			if rock.Parent and hiddenDecoyBalls[rock] ~= nil then
				rock.LocalTransparencyModifier = hiddenDecoyBalls[rock]
			end
			hiddenDecoyBalls[rock] = nil
			figure.model:Destroy()
			rockFigures[rock] = nil
		end
	end

	if not isBlindOne then
		for part, original in hiddenParts do
			if part.Parent then
				part.LocalTransparencyModifier = original
			end
			hiddenParts[part] = nil
		end
		for humanoid, original in hiddenNameplates do
			if humanoid.Parent then
				humanoid.DisplayDistanceType = original
			end
			hiddenNameplates[humanoid] = nil
		end
		for rock, original in hiddenDecoyBalls do
			if rock.Parent then
				rock.LocalTransparencyModifier = original
			end
			hiddenDecoyBalls[rock] = nil
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">BlindOneVisualAnimator</string>
          <string name="Source"><![CDATA[--!strict
-- The imported monster is intentionally a single high-detail shell rather
-- than a skinned Roblox rig. This adds weight and gait motion to that shell so
-- it breathes while idle and no longer looks frozen while moving.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

type MotionState = {
	phase: number,
	transform: CFrame,
	baseC0: CFrame,
}

local states: { [Motor6D]: MotionState } = {}
type LimpState = {
	phase: number,
	poses: { [Motor6D]: CFrame },
	bases: { [Motor6D]: CFrame },
}
local limpStates: { [Model]: LimpState } = {}
local disabledAnimateScripts: { [LocalScript]: boolean } = {}

local function suppressDefaultAnimations(character: Model, suppressed: boolean)
	local animate = character:FindFirstChild("Animate")
	if animate and animate:IsA("LocalScript") then
		if suppressed then
			if disabledAnimateScripts[animate] == nil then
				disabledAnimateScripts[animate] = animate.Enabled
			end
			animate.Enabled = false
		elseif disabledAnimateScripts[animate] ~= nil then
			animate.Enabled = disabledAnimateScripts[animate]
			disabledAnimateScripts[animate] = nil
		end
	end
	if not suppressed then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator then
		-- The stock Roblox walk visibly fights the procedural injured-leg pose.
		-- Stop it locally on every viewer; the limp below becomes the only gait.
		for _, track in animator:GetPlayingAnimationTracks() do
			track:Stop(0.12)
		end
	end
end

local function findJoint(character: Model, name: string): Motor6D?
	local joint = character:FindFirstChild(name, true)
	return if joint and joint:IsA("Motor6D") then joint else nil
end

local function poseJoint(state: LimpState, joint: Motor6D?, target: CFrame, alpha: number)
	if not joint then
		return
	end
	local current = state.poses[joint] or target
	current = current:Lerp(target, alpha)
	state.poses[joint] = current
	if state.bases[joint] == nil then
		state.bases[joint] = joint.C0
	end
	-- C0 is not touched by Roblox's Animator, unlike Transform. Applying the
	-- procedural offset here makes every imported segment reliably follow it.
	joint.Transform = CFrame.identity
	joint.C0 = state.bases[joint] * current
end

local function animateLimp(character: Model, humanoid: Humanoid, root: BasePart, dt: number, now: number, forcedSpeed: number?)
	local state = limpStates[character]
	if not state then
		state = { phase = 0, poses = {}, bases = {} }
		limpStates[character] = state
	end

	local velocity = root.AssemblyLinearVelocity
	local measuredSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local horizontalSpeed = forcedSpeed or measuredSpeed
	local moving = horizontalSpeed > 0.65 and (forcedSpeed ~= nil or humanoid.MoveDirection.Magnitude > 0.05)
	local speedWeight = math.clamp(horizontalSpeed / 15, 0, 1)
	if moving then
		-- One deliberately slow cycle: the healthy leg carries the body, then the
		-- injured leg drags forward late. All curves are continuous at the loop.
		state.phase += dt * (2.65 + horizontalSpeed * 0.13)
	end

	local cycle = math.sin(state.phase)
	local halfWave = 0.5 - 0.5 * math.cos(state.phase)
	local injuredLoad = halfWave * halfWave * (3 - 2 * halfWave)
	local healthyLoad = 1 - injuredLoad
	local dragLift = math.max(0, -cycle)
	local alpha = 1 - math.exp(-(if moving then 8.5 else 4.5) * dt)

	local rootJoint = findJoint(character, "Root")
	local waist = findJoint(character, "Waist")
	local neck = findJoint(character, "Neck")
	local leftHip = findJoint(character, "LeftHip")
	local rightHip = findJoint(character, "RightHip")
	local leftKnee = findJoint(character, "LeftKnee")
	local rightKnee = findJoint(character, "RightKnee")
	local leftAnkle = findJoint(character, "LeftAnkle")
	local rightAnkle = findJoint(character, "RightAnkle")
	local leftShoulder = findJoint(character, "LeftShoulder")
	local rightShoulder = findJoint(character, "RightShoulder")
	local leftElbow = findJoint(character, "LeftElbow")
	local rightElbow = findJoint(character, "RightElbow")

	if moving then
		local hardPlant = injuredLoad * injuredLoad
		local torsoDrop = injuredLoad * (0.18 + speedWeight * 0.08)
		local torsoRoll = math.rad(3.5 + injuredLoad * 9 - healthyLoad * 1.5)
		local lurchForward = injuredLoad * 0.055
		-- The entire creature buckles onto its damaged right leg once per cycle.
		-- This remains obvious even at a distance, while the limbs sell the drag.
		poseJoint(state, rootJoint, CFrame.new(-hardPlant * 0.11, -hardPlant * 0.22, -hardPlant * 0.045)
			* CFrame.Angles(math.rad(-hardPlant * 3.5), 0, math.rad(hardPlant * 7.5)), alpha)
		poseJoint(state, waist, CFrame.new(0, -torsoDrop, -lurchForward)
			* CFrame.Angles(math.rad(-9.5 - injuredLoad * 5), cycle * math.rad(1.5), torsoRoll), alpha)
		poseJoint(state, neck, CFrame.Angles(math.rad(5.5 + injuredLoad * 1.5), 0, -torsoRoll * 0.48), alpha)

		-- Healthy left leg takes the full stride. The hurt right leg remains
		-- flexed, takes only a quarter stride, and catches up late with a toe drag.
		poseJoint(state, leftHip, CFrame.Angles(cycle * math.rad(31), 0, math.rad(-2)), alpha)
		poseJoint(state, leftKnee, CFrame.Angles(math.max(0, cycle) * math.rad(30), 0, 0), alpha)
		poseJoint(state, leftAnkle, CFrame.Angles(-math.max(0, cycle) * math.rad(9), 0, 0), alpha)
		poseJoint(state, rightHip, CFrame.Angles(math.rad(13) - cycle * math.rad(6), 0, math.rad(8)), alpha)
		poseJoint(state, rightKnee, CFrame.Angles(math.rad(28) + dragLift * math.rad(16), 0, 0), alpha)
		poseJoint(state, rightAnkle, CFrame.Angles(math.rad(-15) + dragLift * math.rad(5), 0, math.rad(-4)), alpha)

		-- Long arms counterbalance the limp; the right side hangs heavier.
		poseJoint(state, leftShoulder, CFrame.Angles(-cycle * math.rad(12), 0, math.rad(-5)), alpha)
		poseJoint(state, rightShoulder, CFrame.Angles(cycle * math.rad(6) + math.rad(5), 0, math.rad(8)), alpha)
		poseJoint(state, leftElbow, CFrame.Angles(math.rad(8) + injuredLoad * math.rad(4), 0, 0), alpha)
		poseJoint(state, rightElbow, CFrame.Angles(math.rad(19) + dragLift * math.rad(3), 0, 0), alpha)
	else
		local breath = math.sin(now * 1.45)
		poseJoint(state, rootJoint, CFrame.new(0, breath * 0.012, 0) * CFrame.Angles(0, 0, math.rad(1.5)), alpha)
		poseJoint(state, waist, CFrame.new(0, breath * 0.018, 0)
			* CFrame.Angles(math.rad(-7 + breath * 0.5), 0, math.rad(4.5)), alpha)
		poseJoint(state, neck, CFrame.Angles(math.rad(4 - breath * 0.35), 0, math.rad(-2.5)), alpha)
		poseJoint(state, leftHip, CFrame.Angles(math.rad(-2), 0, math.rad(-1)), alpha)
		poseJoint(state, rightHip, CFrame.Angles(math.rad(11), 0, math.rad(6)), alpha)
		poseJoint(state, leftKnee, CFrame.identity, alpha)
		poseJoint(state, rightKnee, CFrame.Angles(math.rad(24), 0, 0), alpha)
		poseJoint(state, leftAnkle, CFrame.identity, alpha)
		poseJoint(state, rightAnkle, CFrame.Angles(math.rad(-11), 0, math.rad(-3)), alpha)
		poseJoint(state, leftShoulder, CFrame.Angles(math.rad(-3 + breath), 0, math.rad(-4)), alpha)
		poseJoint(state, rightShoulder, CFrame.Angles(math.rad(7 - breath), 0, math.rad(8)), alpha)
		poseJoint(state, leftElbow, CFrame.Angles(math.rad(7), 0, 0), alpha)
		poseJoint(state, rightElbow, CFrame.Angles(math.rad(18), 0, 0), alpha)
	end
end

local function animateCharacter(character: Model, dt: number, now: number, forcedSpeed: number?)
	local visual = character:FindFirstChild("BlindOneVisual")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not visual or not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	if visual:GetAttribute("Articulated") == true then
		animateLimp(character, humanoid, root, dt, now, forcedSpeed)
		return
	end

	local motor = visual:FindFirstChild("BlindOneVisualMotor", true)
	if not motor or not motor:IsA("Motor6D") then
		return
	end

	local state = states[motor]
	if not state then
		state = { phase = 0, transform = CFrame.identity, baseC0 = motor.C0 }
		states[motor] = state
	end

	local velocity = root.AssemblyLinearVelocity
	local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local moving = horizontalSpeed > 0.75 and humanoid.MoveDirection.Magnitude > 0.05
	local sprintWeight = math.clamp((horizontalSpeed - 10) / 8, 0, 1)
	local target: CFrame

	if moving then
		state.phase += dt * (3.35 + horizontalSpeed * 0.18)
		local step = math.sin(state.phase)
		local injuredPlant = math.max(0, step) ^ 2
		local bob = math.abs(step) * 0.055 - injuredPlant * (0.19 + sprintWeight * 0.05)
		local sway = step * 0.035 - injuredPlant * 0.12
		local roll = math.rad(2) + injuredPlant * math.rad(9)
		local pitch = math.rad(5) + injuredPlant * math.rad(4)
		local localVelocity = root.CFrame:VectorToObjectSpace(velocity)
		local directionalLean = math.clamp(-localVelocity.X / 22, -1, 1) * math.rad(2.2)
		target = CFrame.new(sway, bob, 0) * CFrame.Angles(-pitch, 0, roll + directionalLean)
	else
		local breath = math.sin(now * 1.7)
		local slowSway = math.sin(now * 0.72)
		target = CFrame.new(slowSway * 0.018, breath * 0.025, 0)
			* CFrame.Angles(math.rad(breath * 0.42), 0, math.rad(slowSway * 0.35))
	end

	local responsiveness = if moving then 13 else 5
	local alpha = 1 - math.exp(-responsiveness * dt)
	state.transform = state.transform:Lerp(target, alpha)
	motor.Transform = CFrame.identity
	motor.C0 = state.baseC0 * state.transform
end

-- Roblox's Animator writes Motor6D.Transform before PreSimulation. Applying the
-- limp here makes it the final authoritative pose instead of letting the normal
-- walk animation overwrite it on the following frame.
RunService.PreSimulation:Connect(function(dt)
	local now = time()
	local seen: { [Motor6D]: boolean } = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character and player:GetAttribute("Role") == "BlindOne" then
			suppressDefaultAnimations(character, true)
			animateCharacter(character, dt, now)
			local visual = character:FindFirstChild("BlindOneVisual")
			local motor = visual and visual:FindFirstChild("BlindOneVisualMotor", true)
			if motor and motor:IsA("Motor6D") then
				seen[motor] = true
			end
		elseif character then
			suppressDefaultAnimations(character, false)
		end
	end
	local aiMonster = workspace:FindFirstChild("TheBlindOne")
	if aiMonster and aiMonster:IsA("Model") then
		suppressDefaultAnimations(aiMonster, true)
		local visualSpeed = aiMonster:GetAttribute("VisualMoveSpeed")
		animateCharacter(aiMonster, dt, now, if typeof(visualSpeed) == "number" then visualSpeed else 0)
	end

	for motor in states do
		if not seen[motor] or not motor.Parent then
			local oldState = states[motor]
			if motor.Parent then
				motor.C0 = oldState.baseC0
				motor.Transform = CFrame.identity
			end
			states[motor] = nil
		end
	end
	for character in limpStates do
		local player = Players:GetPlayerFromCharacter(character)
		local isAiMonster = character.Name == "TheBlindOne" and character.Parent == workspace
		local visual = character:FindFirstChild("BlindOneVisual")
		local shouldRemove = not character.Parent
			or (not isAiMonster and (not player or player:GetAttribute("Role") ~= "BlindOne"))
			or not visual
			or visual:GetAttribute("Articulated") ~= true
		if shouldRemove then
			local oldState = limpStates[character]
			for joint, baseC0 in oldState.bases do
				if joint.Parent then
					joint.C0 = baseC0
					joint.Transform = CFrame.identity
				end
			end
			limpStates[character] = nil
		end
	end
	for animate, originalEnabled in disabledAnimateScripts do
		local character = animate:FindFirstAncestorOfClass("Model")
		local owner = character and Players:GetPlayerFromCharacter(character)
		local isAiMonster = character ~= nil and character.Name == "TheBlindOne" and character.Parent == workspace
		local shouldRemainDisabled = isAiMonster or (owner ~= nil and owner:GetAttribute("Role") == "BlindOne")
		if not animate.Parent or not shouldRemainDisabled then
			if animate.Parent then
				animate.Enabled = originalEnabled
			end
			disabledAnimateScripts[animate] = nil
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">DisableStudioFreecam</string>
          <string name="Source"><![CDATA[--!strict
-- Keep Studio playtests focused on the actual player camera. Roblox injects a
-- developer Freecam into playtests for place owners; it is not listed in
-- Studio's customizable shortcuts, so remove the injected interface here.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

if not RunService:IsStudio() then
	return
end

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local playerScripts = player:WaitForChild("PlayerScripts")

local function isInjectedFreecam(instance: Instance): boolean
	local compactName = string.lower(instance.Name):gsub("[^%a]", "")
	return compactName == "freecam" or compactName == "freecamera"
end

local function removeFreecam(instance: Instance)
	if isInjectedFreecam(instance) then
		instance:Destroy()
	end
end

for _, container in { playerGui, playerScripts } do
	for _, descendant in container:GetDescendants() do
		removeFreecam(descendant)
	end
	container.DescendantAdded:Connect(function(descendant)
		-- Let Roblox finish parenting the injected hierarchy before removing its
		-- root. The exact injection timing varies between Studio versions.
		task.defer(function()
			if descendant.Parent then
				removeFreecam(descendant)
			end
		end)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">FirstPerson</string>
          <string name="Source"><![CDATA[--!strict
-- First-person camera plus a lightweight local crouch presentation. Looking down
-- shows the lower body without repeatedly walking the full character hierarchy.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character: Model? = nil
local humanoid: Humanoid? = nil
local crouchAlpha = 0
local poseApplied = false
local flashlightPoseApplied = false
local descendantAddedConnection: RBXScriptConnection? = nil
local descendantRemovingConnection: RBXScriptConnection? = nil

-- A small forward offset keeps the camera in front of the face instead of inside
-- the upper torso. Crouching lowers it less than before because the pose itself
-- also lowers the visible character.
local STANDING_CAMERA_OFFSET = Vector3.new(0, 0.3, -0.85)
local CROUCH_CAMERA_OFFSET = Vector3.new(0, -0.32, -0.85)
local CAMERA_RESPONSE = 12

local VISIBLE_BODY_PARTS = {
	UpperTorso = true,
	LowerTorso = true,
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
	Torso = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
}

local CROUCH_JOINTS = {
	Root = true,
	Waist = true,
	LeftHip = true,
	RightHip = true,
	LeftKnee = true,
	RightKnee = true,
	LeftAnkle = true,
	RightAnkle = true,
	RightShoulder = true,
	RightElbow = true,
	RightWrist = true,
	["Right Shoulder"] = true,
}

local visibleParts: { [BasePart]: boolean } = {}
local hiddenFirstPersonParts: { [BasePart]: boolean } = {}
local joints: { [string]: any } = {}

local function isHeadAccessory(accessory: Accessory): boolean
	local accessoryType = accessory.AccessoryType
	if accessoryType == Enum.AccessoryType.Hat
		or accessoryType == Enum.AccessoryType.Hair
		or accessoryType == Enum.AccessoryType.Face then
		return true
	end

	-- Older catalog items are often reported as Unknown, so attachment placement
	-- is the reliable fallback for hair, hats, glasses, and other face items.
	return accessory:FindFirstChild("HatAttachment", true) ~= nil
		or accessory:FindFirstChild("HairAttachment", true) ~= nil
		or accessory:FindFirstChild("FaceFrontAttachment", true) ~= nil
		or accessory:FindFirstChild("FaceCenterAttachment", true) ~= nil
end

-- Studio's Duplicate shortcut can accidentally copy the selected avatar during
-- a playtest when Ctrl is used for crouching. Remove only local orphan copies;
-- the player's real Character is never touched.
local function removeAccidentalCharacterCopy(candidate: Instance)
	task.defer(function()
		if candidate.Parent == workspace
			and candidate:IsA("Model")
			and candidate ~= player.Character
			and candidate.Name == player.Name
			and candidate:FindFirstChildOfClass("Humanoid") then
			candidate:Destroy()
		end
	end)
end

workspace.ChildAdded:Connect(removeAccidentalCharacterCopy)

local function lockCamera()
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
end

local function cacheDescendant(descendant: Instance)
	if descendant:IsA("BasePart") then
		local accessory = descendant:FindFirstAncestorOfClass("Accessory")
		if descendant.Name == "Head"
			or (accessory and accessory:IsA("Accessory") and isHeadAccessory(accessory)) then
			hiddenFirstPersonParts[descendant] = true
		elseif VISIBLE_BODY_PARTS[descendant.Name] or accessory ~= nil then
			-- Keep layered jackets, shirts, pants, shoes, and body accessories. These
			-- are what give the first-person body the dressed look in the references.
			visibleParts[descendant] = true
		end
	end
	if CROUCH_JOINTS[descendant.Name]
		and (descendant:IsA("Motor6D") or descendant:IsA("AnimationConstraint") or descendant:IsA("Bone")) then
		joints[descendant.Name] = descendant
	end
end

local function forgetDescendant(descendant: Instance)
	if descendant:IsA("BasePart") then
		visibleParts[descendant] = nil
		hiddenFirstPersonParts[descendant] = nil
	end
	if joints[descendant.Name] == descendant then
		joints[descendant.Name] = nil
	end
end

local function setCharacter(nextCharacter: Model)
	local nextHumanoid = nextCharacter:WaitForChild("Humanoid") :: Humanoid
	if descendantAddedConnection then
		descendantAddedConnection:Disconnect()
	end
	if descendantRemovingConnection then
		descendantRemovingConnection:Disconnect()
	end

	character = nextCharacter
	humanoid = nextHumanoid
	crouchAlpha = 0
	poseApplied = false
	flashlightPoseApplied = false
	visibleParts = {}
	hiddenFirstPersonParts = {}
	joints = {}
	for _, descendant in nextCharacter:GetDescendants() do
		cacheDescendant(descendant)
	end
	descendantAddedConnection = nextCharacter.DescendantAdded:Connect(cacheDescendant)
	descendantRemovingConnection = nextCharacter.DescendantRemoving:Connect(forgetDescendant)

	nextHumanoid.CameraOffset = STANDING_CAMERA_OFFSET
	lockCamera()
end

local function setJointTransform(name: string, transform: CFrame)
	local joint = joints[name]
	if joint and joint.Parent then
		joint.Transform = transform
	end
end

local function setCrouchPose(alpha: number)
	-- Absolute transforms are intentional: multiplying the previous Transform each
	-- frame compounds rotations and can destabilize upgraded avatar constraints.
	setJointTransform("Root", CFrame.new(0, -0.65 * alpha, 0))
	setJointTransform("LeftHip", CFrame.Angles(math.rad(-32 * alpha), 0, math.rad(-4 * alpha)))
	setJointTransform("RightHip", CFrame.Angles(math.rad(-32 * alpha), 0, math.rad(4 * alpha)))
	setJointTransform("LeftKnee", CFrame.Angles(math.rad(68 * alpha), 0, 0))
	setJointTransform("RightKnee", CFrame.Angles(math.rad(68 * alpha), 0, 0))
	setJointTransform("LeftAnkle", CFrame.Angles(math.rad(-34 * alpha), 0, 0))
	setJointTransform("RightAnkle", CFrame.Angles(math.rad(-34 * alpha), 0, 0))
	setJointTransform("Waist", CFrame.Angles(math.rad(10 * alpha), 0, 0))
end

local function setFlashlightArmPose()
	-- Keep the right arm extended so the hand meets the flashlight grip. Both R15
	-- and classic R6 shoulder names are supported. As the player looks down, lower
	-- the arm with the camera so it remains behind the viewmodel instead of clipping it.
	local camera = workspace.CurrentCamera
	local lookDown = if camera then math.clamp(-camera.CFrame.LookVector.Y, 0, 1) else 0
	local shoulderPitch = 112 - 52 * lookDown
	local elbowPitch = -12 + 18 * lookDown
	setJointTransform("RightShoulder", CFrame.Angles(math.rad(shoulderPitch), math.rad(-6), math.rad(10)))
	setJointTransform("RightElbow", CFrame.Angles(math.rad(elbowPitch), 0, math.rad(-3)))
	setJointTransform("RightWrist", CFrame.Angles(math.rad(-6), 0, 0))
	setJointTransform("Right Shoulder", CFrame.Angles(math.rad(shoulderPitch), 0, math.rad(10)))
end

local function clearFlashlightArmPose()
	setJointTransform("RightShoulder", CFrame.identity)
	setJointTransform("RightElbow", CFrame.identity)
	setJointTransform("RightWrist", CFrame.identity)
	setJointTransform("Right Shoulder", CFrame.identity)
end

if player.Character then
	setCharacter(player.Character)
else
	lockCamera()
end
player.CharacterAdded:Connect(setCharacter)

-- Run after Roblox's camera transparency pass and touch only the cached lower-body
-- parts. This is a small, constant amount of work per rendered frame.
RunService:BindToRenderStep("FirstPersonLowerBody", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local currentCharacter = character
	local currentHumanoid = humanoid
	if not currentCharacter or not currentHumanoid or currentHumanoid.Health <= 0 then
		return
	end

	local isCrouched = player:GetAttribute("Crouched") == true
	local targetAlpha = if isCrouched then 1 else 0
	local blend = 1 - math.exp(-CAMERA_RESPONSE * dt)
	crouchAlpha += (targetAlpha - crouchAlpha) * blend
	local targetCameraOffset = if isCrouched then CROUCH_CAMERA_OFFSET else STANDING_CAMERA_OFFSET
	currentHumanoid.CameraOffset = currentHumanoid.CameraOffset:Lerp(targetCameraOffset, blend)

	for part in visibleParts do
		if part.Parent then
			part.LocalTransparencyModifier = if player:GetAttribute("PhotoModeActive") == true then 1 else 0
		end
	end
	for part in hiddenFirstPersonParts do
		if part.Parent then
			part.LocalTransparencyModifier = 1
		end
	end
end)

-- The Animator has finished before PreSimulation, so this pose layers at the final
-- safe point. Assigning absolute transforms prevents runaway accumulation.
RunService.PreSimulation:Connect(function()
	local currentHumanoid = humanoid
	if not currentHumanoid or currentHumanoid.Health <= 0 then
		return
	end

	if crouchAlpha >= 0.001 then
		setCrouchPose(crouchAlpha)
		poseApplied = true
	elseif poseApplied then
		setCrouchPose(0)
		poseApplied = false
	end
	if player:GetAttribute("Role") ~= "BlindOne" and player:GetAttribute("PhotoModeActive") ~= true then
		setFlashlightArmPose()
		flashlightPoseApplied = true
	elseif flashlightPoseApplied then
		clearFlashlightArmPose()
		flashlightPoseApplied = false
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="22">
        <Properties>
          <string name="Name">Fog</string>
          <string name="Source"><![CDATA[--!strict
-- Distance fog is configured on Lighting by MapBuilder (no Atmosphere override).
-- World-anchored mist adds motion; turning the camera never drags the fog.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local old = workspace:FindFirstChild("ClientGroundFog")
if old then old:Destroy() end
local folder = Instance.new("Folder")
folder.Name, folder.Parent = "ClientGroundFog", workspace
local patches: {{part: Part, emitter: ParticleEmitter, x: number, z: number}} = {}
for z=-2,2 do
	for x=-2,2 do
		local anchor=Instance.new("Part")
		anchor.Name,anchor.Size,anchor.Transparency="MistBank",Vector3.new(18,1,18),1
		anchor.Anchored,anchor.CanCollide,anchor.CanQuery,anchor.CanTouch=true,false,false,false
		anchor.CastShadow,anchor.Parent=false,folder
		local emitter=Instance.new("ParticleEmitter")
		emitter.Name,emitter.Texture="Mist","rbxasset://textures/particles/smoke_main.dds"
		emitter.Color=ColorSequence.new(Color3.fromRGB(117,130,134),Color3.fromRGB(91,108,111))
		emitter.Transparency=NumberSequence.new({
			NumberSequenceKeypoint.new(0,1),
			NumberSequenceKeypoint.new(0.15,0.88),
			NumberSequenceKeypoint.new(0.7,0.93),
			NumberSequenceKeypoint.new(1,1),
		})
		emitter.Size=NumberSequence.new({
			NumberSequenceKeypoint.new(0,12),
			NumberSequenceKeypoint.new(1,23),
		})
		emitter.Lifetime,emitter.Rate=NumberRange.new(8,12),1.2
		emitter.Speed,emitter.Acceleration=NumberRange.new(0.1,0.4),Vector3.new(0.09,0,0.04)
		emitter.Rotation,emitter.RotSpeed=NumberRange.new(0,360),NumberRange.new(-2,2)
		emitter.SpreadAngle=Vector2.new(180,180)
		-- Most of the fog color survives the dark ambient lighting.
		emitter.LightInfluence,emitter.LightEmission=0.12,0.2
		emitter.LockedToPart,emitter.Enabled=false,false
		emitter.Parent=anchor
		table.insert(patches,{part=anchor,emitter=emitter,x=x,z=z})
	end
end
local visible=false
local gridX,gridZ=math.huge,math.huge
RunService.Heartbeat:Connect(function()
	local camera=workspace.CurrentCamera
	local enabled=camera~=nil and player:GetAttribute("Role")~="BlindOne"
		and player:GetAttribute("PhotoModeActive")~=true
	if not enabled then
		if visible then
			for _, patch in patches do patch.emitter.Enabled=false; patch.emitter:Clear() end
		end
		visible=false
		gridX,gridZ=math.huge,math.huge
		return
	end
	if not camera then return end
	local x,z=math.floor(camera.CFrame.X/22),math.floor(camera.CFrame.Z/22)
	if gridX~=x or gridZ~=z then
		gridX,gridZ=x,z
		for _, patch in patches do
			-- Modulo tiling keeps 20/25 banks at their old world position per step.
			local px=x-2+(patch.x-(x-2))%5
			local pz=z-2+(patch.z-(z-2))%5
			local position=Vector3.new(px*22,2.5,pz*22)
			if patch.part.Position~=position then
				patch.emitter:Clear()
				patch.part.Position=position
				patch.emitter:Emit(5)
			end
		end
	end
	if not visible then
		visible=true
		for _, patch in patches do patch.emitter.Enabled=true end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="23">
        <Properties>
          <string name="Name">Hud</string>
          <string name="Source"><![CDATA[--!strict
-- Noise meter, stamina, rock count, objective text, and a dread vignette that closes
-- in as the monster gets near.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local csModule = ReplicatedStorage:WaitForChild("ClientState", 5)
local ClientState = (csModule and require(csModule)) or { stamina = 1 }

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "BlindHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

-- hide the backpack UI (the flashlight is a built-in viewmodel) and mouse cursor
pcall(function()
	game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)
UserInputService.MouseIconEnabled = false
local dot = Instance.new("Frame")
dot.Name = "Crosshair"
dot.AnchorPoint = Vector2.new(0.5, 0.5)
dot.Position = UDim2.fromScale(0.5, 0.5)
dot.Size = UDim2.fromOffset(5, 5)
dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
dot.BackgroundTransparency = 0.1
dot.BorderSizePixel = 0
dot.ZIndex = 10
dot.Parent = gui
local dotCorner = Instance.new("UICorner")
dotCorner.CornerRadius = UDim.new(1, 0)
dotCorner.Parent = dot

-- dread overlay: darkens the screen as the monster closes in
local vignette = Instance.new("Frame")
vignette.Name = "Dread"
vignette.Size = UDim2.fromScale(1, 1)
vignette.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
vignette.BackgroundTransparency = 1
vignette.BorderSizePixel = 0
vignette.ZIndex = 5
vignette.Parent = gui

-- Survivor objective: a restrained analog-horror title card that reads cleanly
-- against both fog and darkness without feeling like a modern quest tracker.
local objectiveBanner = Instance.new("CanvasGroup")
objectiveBanner.Name = "ObjectiveBanner"
objectiveBanner.AnchorPoint = Vector2.new(0.5, 0)
objectiveBanner.Position = UDim2.new(0.5, 0, 0, 16)
objectiveBanner.Size = UDim2.fromOffset(560, 104)
objectiveBanner.BackgroundColor3 = Color3.fromRGB(6, 9, 11)
objectiveBanner.BackgroundTransparency = 0.72
objectiveBanner.BorderSizePixel = 0
objectiveBanner.GroupTransparency = 0
objectiveBanner.Parent = gui

local bannerGradient = Instance.new("UIGradient")
bannerGradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.2, 0.22),
	NumberSequenceKeypoint.new(0.5, 0.05),
	NumberSequenceKeypoint.new(0.8, 0.22),
	NumberSequenceKeypoint.new(1, 1),
})
bannerGradient.Parent = objectiveBanner

local objectiveEyebrow = Instance.new("TextLabel")
objectiveEyebrow.Position = UDim2.fromOffset(0, 7)
objectiveEyebrow.Size = UDim2.new(1, 0, 0, 15)
objectiveEyebrow.BackgroundTransparency = 1
objectiveEyebrow.Font = Enum.Font.GothamMedium
objectiveEyebrow.Text = "THE HOLLOW  /  SURVIVOR DIRECTIVE"
objectiveEyebrow.TextSize = 9
objectiveEyebrow.TextColor3 = Color3.fromRGB(145, 163, 169)
objectiveEyebrow.TextTransparency = 0.13
objectiveEyebrow.Parent = objectiveBanner

local objectiveTitle = Instance.new("TextLabel")
objectiveTitle.Position = UDim2.fromOffset(0, 18)
objectiveTitle.Size = UDim2.new(1, 0, 0, 39)
objectiveTitle.BackgroundTransparency = 1
objectiveTitle.Font = Enum.Font.Garamond
objectiveTitle.Text = "OBJECTIVE"
objectiveTitle.TextSize = 31
objectiveTitle.TextColor3 = Color3.fromRGB(235, 238, 235)
objectiveTitle.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
objectiveTitle.TextStrokeTransparency = 0.25
objectiveTitle.Parent = objectiveBanner

local objectiveRule = Instance.new("Frame")
objectiveRule.AnchorPoint = Vector2.new(0.5, 0)
objectiveRule.Position = UDim2.new(0.5, 0, 0, 56)
objectiveRule.Size = UDim2.fromOffset(390, 2)
objectiveRule.BackgroundColor3 = Color3.fromRGB(211, 221, 220)
objectiveRule.BackgroundTransparency = 0.18
objectiveRule.BorderSizePixel = 0
objectiveRule.Parent = objectiveBanner
local ruleGradient = Instance.new("UIGradient")
ruleGradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.18, 0.35),
	NumberSequenceKeypoint.new(0.5, 0),
	NumberSequenceKeypoint.new(0.82, 0.35),
	NumberSequenceKeypoint.new(1, 1),
})
ruleGradient.Parent = objectiveRule

local objectiveMark = Instance.new("Frame")
objectiveMark.AnchorPoint = Vector2.new(0.5, 0.5)
objectiveMark.Position = UDim2.fromScale(0.5, 0.5)
objectiveMark.Size = UDim2.fromOffset(7, 7)
objectiveMark.Rotation = 45
objectiveMark.BackgroundColor3 = Color3.fromRGB(226, 232, 230)
objectiveMark.BorderSizePixel = 0
objectiveMark.Parent = objectiveRule

local objective = Instance.new("TextLabel")
objective.Position = UDim2.fromOffset(34, 64)
objective.Size = UDim2.new(1, -68, 0, 30)
objective.BackgroundTransparency = 1
objective.Font = Enum.Font.Garamond
objective.TextSize = 17
objective.TextColor3 = Color3.fromRGB(220, 225, 222)
objective.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
objective.TextStrokeTransparency = 0.52
objective.TextWrapped = true
objective.Text = "Awaiting directive..."
objective.Parent = objectiveBanner

-- bottom stack: noise meter + stamina
local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(300, 52)
panel.Position = UDim2.new(0.5, -150, 1, -84)
panel.BackgroundTransparency = 1
panel.Parent = gui

-- Compact horror-styled control card. It stays out of the center of the screen
-- and uses keycaps so new players can understand the game at a glance.
local controlsPanel = Instance.new("Frame")
controlsPanel.Name = "Controls"
controlsPanel.AnchorPoint = Vector2.new(0, 1)
controlsPanel.Position = UDim2.new(0, 22, 1, -24)
controlsPanel.Size = UDim2.fromOffset(218, 220)
controlsPanel.BackgroundColor3 = Color3.fromRGB(7, 10, 13)
controlsPanel.BackgroundTransparency = 0.16
controlsPanel.BorderSizePixel = 0
controlsPanel.Parent = gui
local controlsCorner = Instance.new("UICorner")
controlsCorner.CornerRadius = UDim.new(0, 10)
controlsCorner.Parent = controlsPanel
local controlsStroke = Instance.new("UIStroke")
controlsStroke.Color = Color3.fromRGB(115, 145, 157)
controlsStroke.Transparency = 0.45
controlsStroke.Thickness = 1
controlsStroke.Parent = controlsPanel
local controlsGradient = Instance.new("UIGradient")
controlsGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(17, 24, 29)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 7, 9)),
})
controlsGradient.Rotation = 90
controlsGradient.Parent = controlsPanel

local controlsTitle = Instance.new("TextLabel")
controlsTitle.Position = UDim2.fromOffset(14, 9)
controlsTitle.Size = UDim2.fromOffset(190, 22)
controlsTitle.BackgroundTransparency = 1
controlsTitle.Font = Enum.Font.GothamBold
controlsTitle.Text = "CONTROLS"
controlsTitle.TextSize = 13
controlsTitle.TextXAlignment = Enum.TextXAlignment.Left
controlsTitle.TextColor3 = Color3.fromRGB(205, 224, 232)
controlsTitle.Parent = controlsPanel

local controls = {
	{ "WASD", "MOVE" },
	{ "SHIFT", "SPRINT" },
	{ "CTRL", "CROUCH" },
	{ "F", "FLASHLIGHT" },
	{ "E", "INTERACT / PICK UP" },
	{ "LMB", "THROW BALL" },
}
for index, control in controls do
	local rowY = 38 + (index - 1) * 28
	local key = Instance.new("TextLabel")
	key.Position = UDim2.fromOffset(14, rowY)
	key.Size = UDim2.fromOffset(54, 22)
	key.BackgroundColor3 = Color3.fromRGB(28, 38, 44)
	key.BackgroundTransparency = 0.08
	key.BorderSizePixel = 0
	key.Font = Enum.Font.GothamBold
	key.Text = control[1]
	key.TextSize = 10
	key.TextColor3 = Color3.fromRGB(241, 247, 250)
	key.Parent = controlsPanel
	local keyCorner = Instance.new("UICorner")
	keyCorner.CornerRadius = UDim.new(0, 5)
	keyCorner.Parent = key
	local keyStroke = Instance.new("UIStroke")
	keyStroke.Color = Color3.fromRGB(135, 170, 184)
	keyStroke.Transparency = 0.52
	keyStroke.Parent = key

	local action = Instance.new("TextLabel")
	action.Position = UDim2.fromOffset(80, rowY)
	action.Size = UDim2.fromOffset(124, 22)
	action.BackgroundTransparency = 1
	action.Font = Enum.Font.GothamMedium
	action.Text = control[2]
	action.TextSize = 11
	action.TextXAlignment = Enum.TextXAlignment.Left
	action.TextColor3 = Color3.fromRGB(160, 177, 184)
	action.Parent = controlsPanel
end

local function bar(y: number, labelText: string): (Frame, TextLabel)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.fromOffset(300, 20)
	holder.Position = UDim2.fromOffset(0, y)
	holder.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
	holder.BackgroundTransparency = 0.25
	holder.BorderSizePixel = 0
	holder.Parent = panel
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = holder
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
	fill.BorderSizePixel = 0
	fill.Parent = holder
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0, 4)
	fc.Parent = fill
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextSize = 12
	text.TextColor3 = Color3.fromRGB(240, 240, 240)
	text.Text = labelText
	text.Parent = holder
	return fill, text
end

local noiseFill, noiseText = bar(0, "NOISE")
local stamFill = bar(26, "STAMINA")

-- A separate hotbar-style rock slot keeps inventory information out of the
-- noise meter and leaves room for the equipped-rock behavior on key 1.
local rockSlot = Instance.new("Frame")
rockSlot.Name = "RockInventorySlot"
rockSlot.AnchorPoint = Vector2.new(0, 1)
rockSlot.Position = UDim2.new(0.5, 164, 1, -32)
rockSlot.Size = UDim2.fromOffset(96, 52)
rockSlot.BackgroundColor3 = Color3.fromRGB(8, 11, 14)
rockSlot.BackgroundTransparency = 0.12
rockSlot.BorderSizePixel = 0
rockSlot.Parent = gui
local rockSlotCorner = Instance.new("UICorner")
rockSlotCorner.CornerRadius = UDim.new(0, 8)
rockSlotCorner.Parent = rockSlot
local rockSlotStroke = Instance.new("UIStroke")
rockSlotStroke.Color = Color3.fromRGB(132, 151, 157)
rockSlotStroke.Transparency = 0.35
rockSlotStroke.Thickness = 1
rockSlotStroke.Parent = rockSlot

local rockKey = Instance.new("TextLabel")
rockKey.Position = UDim2.fromOffset(6, 6)
rockKey.Size = UDim2.fromOffset(19, 19)
rockKey.BackgroundColor3 = Color3.fromRGB(31, 40, 44)
rockKey.BorderSizePixel = 0
rockKey.Font = Enum.Font.GothamBold
rockKey.Text = "1"
rockKey.TextSize = 11
rockKey.TextColor3 = Color3.fromRGB(238, 244, 246)
rockKey.Parent = rockSlot
local rockKeyCorner = Instance.new("UICorner")
rockKeyCorner.CornerRadius = UDim.new(0, 4)
rockKeyCorner.Parent = rockKey

local rockIcon = Instance.new("Frame")
rockIcon.AnchorPoint = Vector2.new(0.5, 0.5)
rockIcon.Position = UDim2.fromOffset(49, 27)
rockIcon.Size = UDim2.fromOffset(25, 25)
rockIcon.BackgroundColor3 = Color3.fromRGB(76, 72, 63)
rockIcon.BorderSizePixel = 0
rockIcon.Rotation = -12
rockIcon.Parent = rockSlot
local rockIconCorner = Instance.new("UICorner")
rockIconCorner.CornerRadius = UDim.new(0.38, 0)
rockIconCorner.Parent = rockIcon
local rockIconStroke = Instance.new("UIStroke")
rockIconStroke.Color = Color3.fromRGB(121, 113, 96)
rockIconStroke.Transparency = 0.3
rockIconStroke.Parent = rockIcon

local rockCount = Instance.new("TextLabel")
rockCount.AnchorPoint = Vector2.new(1, 1)
rockCount.Position = UDim2.new(1, -7, 1, -5)
rockCount.Size = UDim2.fromOffset(35, 20)
rockCount.BackgroundTransparency = 1
rockCount.Font = Enum.Font.GothamBold
rockCount.Text = "x0"
rockCount.TextSize = 14
rockCount.TextXAlignment = Enum.TextXAlignment.Right
rockCount.TextColor3 = Color3.fromRGB(237, 241, 239)
rockCount.Parent = rockSlot

local function setRockCount(value: number)
	local count = math.max(0, math.floor(value))
	rockCount.Text = ("x%d"):format(count)
	rockIcon.BackgroundTransparency = if count > 0 then 0 else 0.65
	rockCount.TextTransparency = if count > 0 then 0 else 0.5
end

-- Three compact power indicators make the survivor agenda readable without
-- turning the horror HUD into a quest log.
local progressPanel = Instance.new("Frame")
progressPanel.Name = "GateProgress"
progressPanel.AnchorPoint = Vector2.new(0.5, 0)
progressPanel.Position = UDim2.new(0.5, 0, 0, 126)
progressPanel.Size = UDim2.fromOffset(196, 30)
progressPanel.BackgroundColor3 = Color3.fromRGB(7, 10, 10)
progressPanel.BackgroundTransparency = 0.30
progressPanel.BorderSizePixel = 0
progressPanel.Parent = gui
local progressCorner = Instance.new("UICorner")
progressCorner.CornerRadius = UDim.new(0, 8)
progressCorner.Parent = progressPanel
local progressLabel = Instance.new("TextLabel")
progressLabel.Position = UDim2.fromOffset(10, 0)
progressLabel.Size = UDim2.fromOffset(86, 30)
progressLabel.BackgroundTransparency = 1
progressLabel.Font = Enum.Font.GothamBold
progressLabel.Text = "GATE POWER"
progressLabel.TextSize = 10
progressLabel.TextXAlignment = Enum.TextXAlignment.Left
progressLabel.TextColor3 = Color3.fromRGB(161, 176, 171)
progressLabel.Parent = progressPanel
local progressPips: { Frame } = {}
for index = 1, 3 do
	local pip = Instance.new("Frame")
	pip.Name = "Mechanism" .. index
	pip.Position = UDim2.fromOffset(98 + (index - 1) * 29, 8)
	pip.Size = UDim2.fromOffset(20, 14)
	pip.BackgroundColor3 = Color3.fromRGB(105, 35, 27)
	pip.BorderSizePixel = 0
	pip.Parent = progressPanel
	local pipCorner = Instance.new("UICorner")
	pipCorner.CornerRadius = UDim.new(0, 4)
	pipCorner.Parent = pip
	table.insert(progressPips, pip)
end

local generatedMap = workspace:WaitForChild("GeneratedMap")
local function refreshGateProgress()
	local activeValue = generatedMap:GetAttribute("MechanismsActive")
	local active = if typeof(activeValue) == "number" then activeValue else 0
	progressPanel.Visible = player:GetAttribute("Role") ~= "BlindOne"
	for index, pip in progressPips do
		pip.BackgroundColor3 = if index <= active then Color3.fromRGB(80, 188, 123) else Color3.fromRGB(105, 35, 27)
	end
	if generatedMap:GetAttribute("GateOpen") == true then
		progressLabel.Text = "GATE OPEN"
		progressLabel.TextColor3 = Color3.fromRGB(117, 220, 155)
	else
		progressLabel.Text = "GATE POWER"
		progressLabel.TextColor3 = Color3.fromRGB(161, 176, 171)
	end
end
generatedMap:GetAttributeChangedSignal("MechanismsActive"):Connect(refreshGateProgress)
generatedMap:GetAttributeChangedSignal("GateOpen"):Connect(refreshGateProgress)
player:GetAttributeChangedSignal("Role"):Connect(refreshGateProgress)
refreshGateProgress()

-- remote wiring
local noise = 0
Remotes.NoiseMeter.OnClientEvent:Connect(function(v: number)
	noise = v
end)

local dread = 0
Remotes.Dread.OnClientEvent:Connect(function(v: number)
	dread = v
end)

Remotes.Objective.OnClientEvent:Connect(function(text: string)
	objective.Text = text
	if player:GetAttribute("Role") ~= "BlindOne" then
		objectiveBanner.Position = UDim2.new(0.5, 0, 0, 5)
		objectiveBanner.GroupTransparency = 1
		TweenService:Create(
			objectiveBanner,
			TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Position = UDim2.new(0.5, 0, 0, 16), GroupTransparency = 0 }
		):Play()
		objectiveRule.Size = UDim2.fromOffset(16, 2)
		TweenService:Create(
			objectiveRule,
			TweenInfo.new(0.75, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Size = UDim2.fromOffset(390, 2) }
		):Play()
	end
end)

Remotes.HeldCount.OnClientEvent:Connect(function(n: number)
	setRockCount(n)
end)

RunService.RenderStepped:Connect(function()
	local isBlindOne = player:GetAttribute("Role") == "BlindOne"
	local isPhotoMode = player:GetAttribute("PhotoModeActive") == true
	objectiveBanner.Visible = not isBlindOne
	panel.Visible = not isBlindOne
	controlsPanel.Visible = not isBlindOne
	rockSlot.Visible = not isBlindOne
	local heldValue = player:GetAttribute("HeldBalls")
	if typeof(heldValue) == "number" then
		setRockCount(heldValue)
	end
	local nr = math.clamp(noise / 100, 0, 1)
	noiseFill.Size = UDim2.fromScale(nr, 1)
	noiseFill.BackgroundColor3 = Color3.fromRGB(120, 200, 140):Lerp(Color3.fromRGB(230, 70, 70), nr)

	local sr = math.clamp(ClientState.stamina, 0, 1)
	stamFill.Size = UDim2.fromScale(sr, 1)
	stamFill.BackgroundColor3 = sr < 0.25 and Color3.fromRGB(230, 120, 90) or Color3.fromRGB(90, 150, 230)

	-- Proximity is communicated as a restrained pulse; never crush the whole
	-- scene into black, because the storm lens already shapes the frame edges.
	local pulse = dread > 0.15 and (math.sin(os.clock() * (6 + dread * 10)) * 0.5 + 0.5) * dread * 0.035 or 0
	vignette.BackgroundTransparency = if isBlindOne or isPhotoMode
		then 1
		else math.clamp(1 - (dread * 0.12 + pulse), 0.82, 1)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="24">
        <Properties>
          <string name="Name">JumpController</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local JumpPolicy = require(ReplicatedStorage:WaitForChild("JumpPolicy"))
local player = Players.LocalPlayer

local function refresh()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	-- The server snapshots the original values before locking jumping. Wait for
	-- that snapshot instead of accidentally remembering its replicated zeroes.
	if humanoid and humanoid:GetAttribute("OriginalJumpPower") ~= nil then
		JumpPolicy.Apply(humanoid, player:GetAttribute("Role") ~= "BlindOne")
	end
end

local function characterAdded(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid:GetAttributeChangedSignal("OriginalJumpPower"):Connect(function()
		task.defer(refresh)
	end)
	refresh()
end
player.CharacterAdded:Connect(characterAdded)
player:GetAttributeChangedSignal("Role"):Connect(refresh)
if player.Character then task.spawn(characterAdded, player.Character) end

ContextActionService:BindActionAtPriority("NoSurvivorJump", function()
	return if player:GetAttribute("Role") ~= "BlindOne"
		then Enum.ContextActionResult.Sink else Enum.ContextActionResult.Pass
end, false, Enum.ContextActionPriority.High.Value + 10, Enum.PlayerActions.CharacterJump)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">Lantern</string>
          <string name="Source"><![CDATA[--!strict
-- Hand-tracked survivor flashlight. It uses the old lantern's proven hand-first
-- positioning, but aims both the prop and its light at the camera crosshair.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer

local obsoleteGrade = Lighting:FindFirstChild("LanternMonsterDreadGrade")
if obsoleteGrade then obsoleteGrade:Destroy() end
for _, oldName in { "LanternView", "LanternGlow", "HeldLanternView", "HeldFlashlightView" } do
	local old = Workspace:FindFirstChild(oldName)
	if old then old:Destroy() end
end

local flashlight = Instance.new("Model")
flashlight.Name = "HeldFlashlightView"
flashlight.Parent = Workspace

local root = Instance.new("Part")
root.Name = "ViewRoot"
root.Size = Vector3.new(0.04, 0.04, 0.04)
root.Transparency = 1
root.Anchored = true
root.CanCollide, root.CanTouch, root.CanQuery, root.CastShadow = false, false, false, false
root.CFrame = CFrame.identity
root.Parent = flashlight
flashlight.PrimaryPart = root

local function makePart(name: string, size: Vector3, color: Color3, material: Enum.Material, localCFrame: CFrame, shape: Enum.PartType?, transparency: number?): Part
	local object = Instance.new("Part")
	object.Name, object.Size, object.Color, object.Material = name, size, color, material
	object.Shape, object.Transparency = shape or Enum.PartType.Block, transparency or 0
	object.Anchored = true
	object.CanCollide, object.CanTouch, object.CanQuery, object.CastShadow = false, false, false, false
	object.CFrame = localCFrame
	object.Parent = flashlight
	return object
end

local blackMetal = Color3.fromRGB(20, 23, 25)
local edgeMetal = Color3.fromRGB(55, 62, 65)
local rubber = Color3.fromRGB(13, 15, 16)
local axisForward = CFrame.Angles(0, math.rad(90), 0)

-- Pivot sits inside the player's palm. The body extends forward along local -Z.
makePart("RubberGrip", Vector3.new(0.9, 0.34, 0.34), rubber, Enum.Material.Rubber, CFrame.new(0, 0, 0.08) * axisForward, Enum.PartType.Cylinder)
makePart("MainBarrel", Vector3.new(0.92, 0.3, 0.3), blackMetal, Enum.Material.Metal, CFrame.new(0, 0, -0.48) * axisForward, Enum.PartType.Cylinder)
makePart("TailCap", Vector3.new(0.13, 0.4, 0.4), edgeMetal, Enum.Material.Metal, CFrame.new(0, 0, 0.56) * axisForward, Enum.PartType.Cylinder)
makePart("Head", Vector3.new(0.32, 0.58, 0.58), blackMetal, Enum.Material.Metal, CFrame.new(0, 0, -1.08) * axisForward, Enum.PartType.Cylinder)
makePart("Bezel", Vector3.new(0.12, 0.67, 0.67), edgeMetal, Enum.Material.Metal, CFrame.new(0, 0, -1.29) * axisForward, Enum.PartType.Cylinder)
local lens = makePart("Lens", Vector3.new(0.045, 0.55, 0.55), Color3.fromRGB(172, 189, 193), Enum.Material.Glass, CFrame.new(0, 0, -1.38) * axisForward, Enum.PartType.Cylinder, 0.24)
makePart("Switch", Vector3.new(0.2, 0.09, 0.18), Color3.fromRGB(91, 99, 101), Enum.Material.Metal, CFrame.new(0, 0.2, -0.38))

-- Cylinder geometry needs a 90-degree rotation to point forward, which also
-- rotates its Front face sideways. Keep lighting on an unrotated invisible
-- emitter so both SpotLights always follow the model's true -Z/look direction.
local beamEmitter = makePart("BeamEmitter", Vector3.new(0.03, 0.03, 0.03), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, CFrame.new(0, 0, -1.41), nil, 1)

for index = 1, 6 do
	makePart("GripRib", Vector3.new(0.045, 0.38, 0.38), edgeMetal, Enum.Material.Metal, CFrame.new(0, 0, 0.42 - index * 0.13) * axisForward, Enum.PartType.Cylinder)
end

local hotspot = Instance.new("SpotLight")
hotspot.Name = "FocusedHotspot"
hotspot.Face = Enum.NormalId.Front
hotspot.Color = Color3.fromRGB(222, 230, 231)
hotspot.Brightness = 6.4
hotspot.Range = 82
hotspot.Angle = 48
hotspot.Shadows = true
hotspot.Parent = beamEmitter

local spill = Instance.new("SpotLight")
spill.Name = "SoftSpill"
spill.Face = Enum.NormalId.Front
spill.Color = Color3.fromRGB(188, 202, 205)
spill.Brightness = 1.8
spill.Range = 52
spill.Angle = 92
spill.Shadows = false
spill.Parent = beamEmitter

local nearFill = Instance.new("PointLight")
nearFill.Name = "NearFill"
nearFill.Color = Color3.fromRGB(184, 197, 200)
nearFill.Brightness = 0.26
nearFill.Range = 7
nearFill.Shadows = false
nearFill.Parent = beamEmitter

local rightHand: BasePart? = nil
local lightEnabled = true

local function findRightHand(character: Model)
	local candidate = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	rightHand = if candidate and candidate:IsA("BasePart") then candidate else nil
	if not rightHand then
		task.spawn(function()
			local later = character:WaitForChild("RightHand", 5) or character:FindFirstChild("Right Arm")
			if later and later:IsA("BasePart") and player.Character == character then rightHand = later end
		end)
	end
end

if player.Character then findRightHand(player.Character) end
player.CharacterAdded:Connect(function(character)
	rightHand = nil
	findRightHand(character)
end)

local function applyLightState()
	hotspot.Enabled, spill.Enabled, nearFill.Enabled = lightEnabled, lightEnabled, lightEnabled
	lens.Material = Enum.Material.Glass
	lens.Transparency = if lightEnabled then 0.18 else 0.46
	lens.Color = if lightEnabled then Color3.fromRGB(185, 201, 204) else Color3.fromRGB(45, 53, 55)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and not UserInputService:GetFocusedTextBox() and input.KeyCode == Enum.KeyCode.F and player:GetAttribute("Role") ~= "BlindOne" then
		lightEnabled = not lightEnabled
		applyLightState()
	end
end)
applyLightState()

RunService:BindToRenderStep("HeldFlashlightView", Enum.RenderPriority.Camera.Value + 2, function()
	if player:GetAttribute("Role") == "BlindOne" or player:GetAttribute("PhotoModeActive") == true then
		if flashlight.Parent then flashlight.Parent = nil end
		return
	elseif not flashlight.Parent then
		flashlight.Parent = Workspace
	end

	local camera = Workspace.CurrentCamera
	local hand = rightHand
	if not camera or not hand or not hand.Parent then return end

	local lookDown = math.clamp(-camera.CFrame.LookVector.Y, 0, 1)
	local handDepth = (hand.Position - camera.CFrame.Position):Dot(camera.CFrame.LookVector)
	local handCenter = hand.Position + camera.CFrame.LookVector * 0.22 - camera.CFrame.UpVector * (0.05 + 0.08 * lookDown)
	local cameraCenter = (camera.CFrame * CFrame.new(0.7, -0.54 - 0.2 * lookDown, -1.35)).Position
	-- Normal avatars use the real hand. The fallback prevents unusual rigs from
	-- putting the prop behind the camera while keeping it on the right-hand side.
	local center = if handDepth > 0.18 then handCenter:Lerp(cameraCenter, 0.2) else cameraCenter

	local movement = 0
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then movement = math.clamp(humanoid.MoveDirection.Magnitude, 0, 1) end
	local walkClock = os.clock() * 8.2
	local bob = camera.CFrame.UpVector * (math.sin(walkClock * 2) * 0.018 * movement)
		+ camera.CFrame.RightVector * (math.sin(walkClock) * 0.025 * movement)
	local roll = math.rad(math.sin(walkClock) * 1.4 * movement)
	local target = CFrame.lookAt(center + bob, center + bob + camera.CFrame.LookVector, camera.CFrame.UpVector) * CFrame.Angles(0, 0, roll)
	-- Direct hand tracking prevents the sideways trailing seen with extra easing.
	flashlight:PivotTo(target)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">MoveController</string>
          <string name="Source"><![CDATA[--!strict
-- Walk / crouch / sprint. Sets local WalkSpeed and tells the server which state
-- you're in so the noise system knows how loud you are.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local csModule = ReplicatedStorage:WaitForChild("ClientState", 5)
local ClientState = (csModule and require(csModule)) or { stamina = 1 }

local player = Players.LocalPlayer

local crouched = false
local stamina = Config.StaminaMax
local exhausted = false
local sentState = ""

local function humanoid(): Humanoid?
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

-- Poll held input instead of relying on one-time input callbacks. This cannot get
-- stuck if focus changes while Shift is held.
local function wantsToSprint(): boolean
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
		return true
	end
	return UserInputService.GamepadEnabled
		and UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL3)
end

-- Poll crouch just like sprint so releasing Ctrl always stands the player up,
-- even if Studio or the camera consumed one of the input events.
local function wantsToCrouch(): boolean
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
		return true
	end
	return UserInputService.GamepadEnabled
		and UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonB)
end

-- Set WalkSpeed before the physics step that consumes it. The server mirrors this
-- validated state as well, which keeps movement working with server authority on.
RunService.PreSimulation:Connect(function(dt)
	local hum = humanoid()
	if not hum or hum.Health <= 0 then
		return
	end
	if player:GetAttribute("PhotoModeActive") == true then
		hum:Move(Vector3.zero)
		hum.WalkSpeed, hum.Jump = 0, false
		crouched = false
		player:SetAttribute("Crouched", false)
		ClientState.move, ClientState.walkSpeed = "idle", 0
		if sentState ~= "idle" then
			sentState = "idle"
			Remotes.SetMoveState:FireServer("idle")
		end
		return
	end
	if player:GetAttribute("Role") == "BlindOne" then
		crouched = false
		stamina = Config.StaminaMax
		exhausted = false
		hum.WalkSpeed = Config.PlayerBlindOneSpeed
		player:SetAttribute("Crouched", false)
		ClientState.stamina = 1
		ClientState.move = "monster"
		ClientState.walkSpeed = Config.PlayerBlindOneSpeed
		sentState = "monster"
		return
	end

	local wantSprint = wantsToSprint()
	crouched = wantsToCrouch() and not wantSprint
	local moving = hum.MoveDirection.Magnitude > 0.1
	local sprinting = wantSprint and moving and not crouched and not exhausted

	if sprinting then
		stamina = math.max(0, stamina - Config.StaminaDrainPerSec * dt)
		if stamina <= 0 then
			exhausted = true
		end
	else
		stamina = math.min(Config.StaminaMax, stamina + Config.StaminaRegenPerSec * dt)
		if exhausted and stamina > Config.StaminaMax * 0.35 then
			exhausted = false
		end
	end
	ClientState.stamina = math.clamp(stamina / Config.StaminaMax, 0, 1)

	local state, speed
	if sprinting then
		state, speed = "sprint", Config.SprintSpeed
	elseif crouched then
		state, speed = "crouch", Config.CrouchSpeed
	elseif moving then
		state, speed = "walk", Config.WalkSpeed
	else
		state, speed = "idle", crouched and Config.CrouchSpeed or Config.WalkSpeed
	end

	hum.WalkSpeed = speed
	player:SetAttribute("Crouched", crouched)
	ClientState.move = state
	ClientState.walkSpeed = speed

	if state ~= sentState then
		sentState = state
		Remotes.SetMoveState:FireServer(state)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="27">
        <Properties>
          <string name="Name">PhotoMode</string>
          <string name="Source"><![CDATA[--!strict
-- Studio-only convenience for photographing the solo AI monster.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")

if not RunService:IsStudio() then
	return
end

local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local player = Players.LocalPlayer
local controls = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
local flightState: any = nil
local windowFocused = true
UserInputService.WindowFocused:Connect(function() windowFocused = true end)
UserInputService.WindowFocusReleased:Connect(function() windowFocused = false end)

local function startFlight()
	local camera = workspace.CurrentCamera
	if flightState or not camera then return end
	local pitch, yaw = camera.CFrame:ToOrientation()
	flightState = {
		camera = camera, cameraType = camera.CameraType, subject = camera.CameraSubject,
		frame = camera.CFrame, focus = camera.Focus,
		mouseBehavior = UserInputService.MouseBehavior, mouseIcon = UserInputService.MouseIconEnabled,
		prompts = ProximityPromptService.Enabled,
		position = camera.CFrame.Position, pitch = pitch, yaw = yaw,
	}
	controls:Disable()
	ProximityPromptService.Enabled = false
	camera.CameraType = Enum.CameraType.Scriptable
	RunService:BindToRenderStep("PhotoModeFlight", Enum.RenderPriority.Camera.Value + 3, function(dt)
		local state = flightState
		if not state or workspace.CurrentCamera ~= state.camera then return end
		local typing = UserInputService:GetFocusedTextBox() ~= nil
		local inMenu = game:GetService("GuiService").MenuIsOpen
		if windowFocused and not typing and not inMenu then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
			local mouse = UserInputService:GetMouseDelta()
			state.yaw -= mouse.X * 0.0025
			state.pitch = math.clamp(state.pitch - mouse.Y * 0.0025, -math.pi/2 + 0.01, math.pi/2 - 0.01)
			local function key(code: Enum.KeyCode): number
				return if UserInputService:IsKeyDown(code) then 1 else 0
			end
			local rotation = CFrame.fromOrientation(state.pitch, state.yaw, 0)
			local direction = rotation.LookVector * (key(Enum.KeyCode.W)-key(Enum.KeyCode.S))
				+ rotation.RightVector * (key(Enum.KeyCode.D)-key(Enum.KeyCode.A))
				+ Vector3.yAxis * (math.max(key(Enum.KeyCode.Space),key(Enum.KeyCode.E))
					- math.max(key(Enum.KeyCode.Q),key(Enum.KeyCode.LeftControl),key(Enum.KeyCode.RightControl)))
			local fast = key(Enum.KeyCode.LeftShift) + key(Enum.KeyCode.RightShift) > 0
			if direction.Magnitude > 0 then
				state.position += direction.Unit * (if fast then 72 else 28) * math.min(dt, 0.1)
			end
		end
		state.camera.CameraType = Enum.CameraType.Scriptable
		state.camera.CFrame = CFrame.new(state.position) * CFrame.fromOrientation(state.pitch, state.yaw, 0)
		state.camera.Focus = state.camera.CFrame * CFrame.new(0, 0, -24)
	end)
end

local function stopFlight()
	local state = flightState
	if not state then return end
	flightState = nil
	RunService:UnbindFromRenderStep("PhotoModeFlight")
	local camera = workspace.CurrentCamera
	if camera then
		local character = player.Character
		camera.CameraSubject = (character and character:FindFirstChildOfClass("Humanoid")) or state.subject
		camera.CFrame, camera.Focus, camera.CameraType = state.frame, state.focus, state.cameraType
	end
	UserInputService.MouseBehavior, UserInputService.MouseIconEnabled = state.mouseBehavior, state.mouseIcon
	ProximityPromptService.Enabled = state.prompts
	controls:Enable()
end

type AtmosphereState = {
	density: number,
	haze: number,
	glare: number,
	offset: number,
	color: Color3,
	decay: Color3,
}

type LightingState = {
	clockTime: number,
	brightness: number,
	ambient: Color3,
	outdoorAmbient: Color3,
	fogColor: Color3,
	fogStart: number,
	fogEnd: number,
	exposure: number,
	atmospheres: { [Atmosphere]: AtmosphereState },
}

local savedLighting: LightingState? = nil

local function enableInspectionLighting()
	if savedLighting then
		return
	end

	local atmospheres: { [Atmosphere]: AtmosphereState } = {}
	for _, effect in Lighting:GetChildren() do
		if effect:IsA("Atmosphere") then
			atmospheres[effect] = {
				density = effect.Density,
				haze = effect.Haze,
				glare = effect.Glare,
				offset = effect.Offset,
				color = effect.Color,
				decay = effect.Decay,
			}
			effect.Density = 0
			effect.Haze = 0
			effect.Glare = 0
		end
	end

	savedLighting = {
		clockTime = Lighting.ClockTime,
		brightness = Lighting.Brightness,
		ambient = Lighting.Ambient,
		outdoorAmbient = Lighting.OutdoorAmbient,
		fogColor = Lighting.FogColor,
		fogStart = Lighting.FogStart,
		fogEnd = Lighting.FogEnd,
		exposure = Lighting.ExposureCompensation,
		atmospheres = atmospheres,
	}

	-- Photo mode changes only visibility: bright daylight removes the darkness
	-- and Atmosphere/Fog are cleared above. Bloom, depth of field, color grade,
	-- Future lighting, wet reflections, shadows, and weather remain untouched.
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 3.1
	Lighting.Ambient = Color3.fromRGB(142, 150, 153)
	Lighting.OutdoorAmbient = Color3.fromRGB(164, 174, 178)
	Lighting.FogColor = Color3.fromRGB(235, 238, 240)
	Lighting.FogStart = 100000
	Lighting.FogEnd = 100001
	Lighting.ExposureCompensation = 0.72
end

local function restoreGameplayLighting()
	local state = savedLighting
	if not state then
		return
	end
	savedLighting = nil

	Lighting.ClockTime = state.clockTime
	Lighting.Brightness = state.brightness
	Lighting.Ambient = state.ambient
	Lighting.OutdoorAmbient = state.outdoorAmbient
	Lighting.FogColor = state.fogColor
	Lighting.FogStart = state.fogStart
	Lighting.FogEnd = state.fogEnd
	Lighting.ExposureCompensation = state.exposure

	for atmosphere, atmosphereState in state.atmospheres do
		if atmosphere.Parent then
			atmosphere.Density = atmosphereState.density
			atmosphere.Haze = atmosphereState.haze
			atmosphere.Glare = atmosphereState.glare
			atmosphere.Offset = atmosphereState.offset
			atmosphere.Color = atmosphereState.color
			atmosphere.Decay = atmosphereState.decay
		end
	end
end

local gui = Instance.new("ScreenGui")
gui.Name = "PhotoModeHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 1)
label.Position = UDim2.new(0.5, 0, 1, -84)
label.Size = UDim2.new(0.94, 0, 0, 54)
local sizeLimit = Instance.new("UISizeConstraint")
sizeLimit.MaxSize, sizeLimit.Parent = Vector2.new(680, 54), label
label.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
label.BackgroundTransparency = 0.22
label.BorderSizePixel = 0
label.Font = Enum.Font.GothamBold
label.TextColor3 = Color3.fromRGB(225, 235, 238)
label.TextSize = 15
label.TextWrapped = true
label.Text = "Press P for Photo Mode / free flight"
label.Parent = gui

player:GetAttributeChangedSignal("Role"):Connect(function()
	gui.Enabled = player:GetAttribute("Role") ~= "BlindOne"
	if player:GetAttribute("Role") == "BlindOne" and savedLighting then
		player:SetAttribute("PhotoModeActive", false)
		stopFlight()
		restoreGameplayLighting()
		Remotes.PhotoMode:FireServer(false)
	end
end)
gui.Enabled = player:GetAttribute("Role") ~= "BlindOne"

UserInputService.InputBegan:Connect(function(input)
	if UserInputService:GetFocusedTextBox() then
		return
	end
	local shiftHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	if input.KeyCode == Enum.KeyCode.P and not shiftHeld and player:GetAttribute("Role") ~= "BlindOne" then
		Remotes.PhotoMode:FireServer()
	end
end)

Remotes.PhotoMode.OnClientEvent:Connect(function(frozen: boolean)
	if frozen and (player:GetAttribute("Role") == "BlindOne" or not player.Character) then
		Remotes.PhotoMode:FireServer(false)
		return
	end
	player:SetAttribute("PhotoModeActive", frozen)
	if frozen then
		enableInspectionLighting()
		startFlight()
	else
		stopFlight()
		restoreGameplayLighting()
	end
	label.Text = if frozen
		then "PHOTO FLIGHT  ·  WASD + mouse  ·  Space/E up  ·  Q/Ctrl down\nShift faster  ·  P return  ·  Clear lighting / graphics on"
		else "Press P for Photo Mode / free flight"
	label.TextColor3 = if frozen then Color3.fromRGB(190, 235, 245) else Color3.fromRGB(225, 235, 238)
end)

player.CharacterRemoving:Connect(function()
	if savedLighting or flightState then
		player:SetAttribute("PhotoModeActive", false)
		stopFlight()
		restoreGameplayLighting()
		Remotes.PhotoMode:FireServer(false)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">ThrowController</string>
          <string name="Source"><![CDATA[--!strict
-- E: pick up a nearby rock.  Left click / R2: throw one where you're looking.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local player = Players.LocalPlayer
local PICKUP_RANGE = 12

local pickupOutline = Instance.new("Highlight")
pickupOutline.Name = "LocalBallPickupOutline"
pickupOutline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
pickupOutline.FillTransparency = 1
pickupOutline.OutlineColor = Color3.fromRGB(245, 250, 255)
pickupOutline.OutlineTransparency = 0.02
pickupOutline.Enabled = false
pickupOutline.Parent = Workspace

local pickupBillboard = Instance.new("BillboardGui")
pickupBillboard.Name = "LocalBallPickupPrompt"
pickupBillboard.AlwaysOnTop = true
pickupBillboard.LightInfluence = 0
pickupBillboard.MaxDistance = PICKUP_RANGE + 3
pickupBillboard.Size = UDim2.fromOffset(112, 34)
pickupBillboard.StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0)
pickupBillboard.Enabled = false
pickupBillboard.Parent = player:WaitForChild("PlayerGui")

local prompt = Instance.new("TextLabel")
prompt.Size = UDim2.fromScale(1, 1)
prompt.BackgroundColor3 = Color3.fromRGB(8, 11, 14)
prompt.BackgroundTransparency = 0.15
prompt.BorderSizePixel = 0
prompt.Font = Enum.Font.GothamBold
prompt.Text = "E  ·  PICK UP"
prompt.TextSize = 13
prompt.TextColor3 = Color3.fromRGB(245, 250, 255)
prompt.TextStrokeTransparency = 0.7
prompt.Parent = pickupBillboard
local promptCorner = Instance.new("UICorner")
promptCorner.CornerRadius = UDim.new(0, 7)
promptCorner.Parent = prompt
local promptStroke = Instance.new("UIStroke")
promptStroke.Color = Color3.fromRGB(185, 215, 230)
promptStroke.Thickness = 1
promptStroke.Transparency = 0.28
promptStroke.Parent = prompt

local function root(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart? or nil
end

local function lookedAtRock(): BasePart?
	local hrp = root()
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local held = player:GetAttribute("HeldBalls")
	if not hrp or not camera or not character or (typeof(held) == "number" and held >= Config.MaxThrowables) then
		return nil
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	rayParams.IgnoreWater = true
	local origin = camera.CFrame.Position
	local result = Workspace:Raycast(origin, camera.CFrame.LookVector * (PICKUP_RANGE + 4), rayParams)
	local rock = result and result.Instance
	if rock and rock:IsA("BasePart") and rock:HasTag("Throwable") and (rock.Position - hrp.Position).Magnitude <= PICKUP_RANGE then
		return rock
	end
	return nil
end

RunService.RenderStepped:Connect(function()
	local target = if player:GetAttribute("Role") ~= "BlindOne" and player:GetAttribute("PhotoModeActive") ~= true then lookedAtRock() else nil
	pickupOutline.Adornee = target
	pickupOutline.Enabled = target ~= nil
	pickupBillboard.Adornee = target
	pickupBillboard.Enabled = target ~= nil
end)

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or player:GetAttribute("Role") == "BlindOne" or player:GetAttribute("PhotoModeActive") == true then
		return
	end
	if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonX then
		local rock = lookedAtRock()
		local camera = Workspace.CurrentCamera
		if rock and camera then
			Remotes.Pickup:FireServer(rock, camera.CFrame.Position, camera.CFrame.LookVector)
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
		local cam = Workspace.CurrentCamera
		if cam then
			Remotes.Throw:FireServer(cam.CFrame.LookVector)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="29">
        <Properties>
          <string name="Name">Weather</string>
          <string name="Source"><![CDATA[--!strict
-- Local cinematic storm. Everything is pooled so the rain can look dense
-- without continuously creating and destroying instances.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local rng = Random.new(7721)
local rainFolder = Instance.new("Folder")
rainFolder.Name = "ClientStorm"
rainFolder.Parent = workspace

local FALL = Vector3.new(-4, -112, -2)
local RADIUS = 48
local STREAK_COUNT = 104
local streaks: { Part } = {}

local function placeStreak(streak: Part, cameraPosition: Vector3, fullHeight: boolean)
	local position = cameraPosition + Vector3.new(
		rng:NextNumber(-RADIUS, RADIUS),
		rng:NextNumber(if fullHeight then -4 else 28, 48),
		rng:NextNumber(-RADIUS, RADIUS)
	)
	streak.Position = position
	streak:SetAttribute("RainSpeed", rng:NextNumber(0.82, 1.24))
end

for index = 1, STREAK_COUNT do
	local streak = Instance.new("Part")
	streak.Name = "Rain"
	streak.Anchored = true
	streak.CanCollide = false
	streak.CanQuery = false
	streak.CanTouch = false
	streak.CastShadow = false
	streak.Material = Enum.Material.Neon
	streak.Color = Color3.fromRGB(151, 165, 170)
	streak.Transparency = rng:NextNumber(0.72, 0.88)
	streak.Size = Vector3.new(0.018, 0.018, rng:NextNumber(1.5, 3.3))
	streak.Parent = rainFolder
	streaks[index] = streak
end

-- Subtle screen-edge falloff adds the heavy analog lens feel without placing a
-- dark overlay over the player's actual field of view.
local stormGui = Instance.new("ScreenGui")
stormGui.Name = "StormLens"
stormGui.IgnoreGuiInset = true
stormGui.ResetOnSpawn = false
stormGui.DisplayOrder = -5
stormGui.Parent = player:WaitForChild("PlayerGui")

local function edge(name: string, position: UDim2, size: UDim2, rotation: number)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Position = position
	frame.Size = size
	frame.BackgroundColor3 = Color3.fromRGB(3, 6, 8)
	frame.BackgroundTransparency = 0.32
	frame.BorderSizePixel = 0
	frame.Parent = stormGui
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.06),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
end

edge("TopVignette", UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.17), 90)
edge("BottomVignette", UDim2.fromScale(0, 0.82), UDim2.fromScale(1, 0.18), 270)
edge("LeftVignette", UDim2.fromScale(0, 0), UDim2.fromScale(0.12, 1), 0)
edge("RightVignette", UDim2.fromScale(0.88, 0), UDim2.fromScale(0.12, 1), 180)

local function refreshStormLens()
	-- Rain and the renderer stay active in Photo Mode; only the dark lens edges
	-- disappear so the model can be inspected without any artificial darkness.
	stormGui.Enabled = player:GetAttribute("PhotoModeActive") ~= true and player:GetAttribute("Role") ~= "BlindOne"
end
player:GetAttributeChangedSignal("PhotoModeActive"):Connect(refreshStormLens)
player:GetAttributeChangedSignal("Role"):Connect(refreshStormLens)
refreshStormLens()

local lightning = Instance.new("ColorCorrectionEffect")
lightning.Name = "StormLightningFlash"
lightning.Brightness = 0
lightning.Contrast = 0
lightning.Saturation = -0.08
lightning.TintColor = Color3.fromRGB(205, 224, 232)
lightning.Parent = Lighting

local nextLightning = os.clock() + rng:NextNumber(28, 55)
local initialized = false
local shelterParams = RaycastParams.new()
shelterParams.FilterType = Enum.RaycastFilterType.Include
shelterParams.RespectCanCollide = true
local sheltered = false
local nextShelterCheck = 0

RunService.RenderStepped:Connect(function(deltaTime)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	if os.clock() >= nextShelterCheck then
		nextShelterCheck = os.clock() + 0.12
		local map = workspace:FindFirstChild("GeneratedMap")
		shelterParams.FilterDescendantsInstances = if map then {map} else {}
		sheltered = workspace:Raycast(cameraPosition, Vector3.new(0,256,0), shelterParams) ~= nil
	end
	if player:GetAttribute("Role") == "BlindOne" or sheltered then
		rainFolder.Parent = nil
		lightning.Enabled = false
		initialized = false
		return
	end
	rainFolder.Parent = workspace
	lightning.Enabled = player:GetAttribute("PhotoModeActive") ~= true
	if not initialized then
		for _, streak in streaks do
			placeStreak(streak, cameraPosition, true)
		end
		initialized = true
	end

	for _, streak in streaks do
		local speedValue = streak:GetAttribute("RainSpeed")
		local speed = if typeof(speedValue) == "number" then speedValue else 1
		local position = streak.Position + FALL * deltaTime * speed
		local offset = position - cameraPosition
		if position.Y < cameraPosition.Y - 10 or math.abs(offset.X) > RADIUS + 8 or math.abs(offset.Z) > RADIUS + 8 then
			placeStreak(streak, cameraPosition, false)
			position = streak.Position
		end
		streak.CFrame = CFrame.lookAt(position, position + FALL.Unit)
	end

	if os.clock() >= nextLightning then
		nextLightning = os.clock() + rng:NextNumber(34, 72)
		lightning.Brightness = 0
		local flashIn = TweenService:Create(lightning, TweenInfo.new(0.055), { Brightness = 0.42, Contrast = 0.08 })
		local flashOut = TweenService:Create(lightning, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0, Contrast = 0 })
		flashIn:Play()
		flashIn.Completed:Once(function()
			flashOut:Play()
		end)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>