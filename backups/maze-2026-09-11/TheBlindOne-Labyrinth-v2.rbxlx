    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">ClientState</string>
        <string name="Source"><![CDATA[--!strict
-- Shared table for client-only state handed between LocalScripts on the same client.
-- (Every LocalScript that require()s this module gets the same table.)
return {
	stamina = 1, -- 0..1, written by MoveController, read by the HUD
	move = "idle", -- "idle" | "walk" | "crouch" | "sprint", written by MoveController
	walkSpeed = 0, -- current Humanoid.WalkSpeed, for the debug readout
}
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">Config</string>
        <string name="Source"><![CDATA[--!strict
-- All tuning for The Blind One. Change numbers here; no other edits needed.
return {
	-- ---- player movement ----
	WalkSpeed = 11,
	CrouchSpeed = 6,
	SprintSpeed = 20,
	StaminaMax = 4.5, -- seconds of sprint
	StaminaDrainPerSec = 1,
	StaminaRegenPerSec = 0.7,

	-- ---- noise ----
	-- Each player has a 0..100 "noise" meter. The monster hears the world in the
	-- same units: a sound of loudness L is audible out to about L * NoiseCarry studs.
	NoiseWalk = 24, -- meter target while walking at full speed
	NoiseCrouch = 3,
	NoiseSprint = 78,
	NoiseIdle = 0,
	NoiseSmoothing = 6, -- how fast the meter chases its target, per second
	FootstepInterval = 0.45, -- seconds between positional footstep blips while moving
	NoiseCarry = 1.7, -- studs of travel per point of loudness
	DoorNoise = 55,
	ThrowImpactNoise = 95,
	BumpNoise = 32,

	-- ---- monster: The Blind One ----
	MonsterWanderSpeed = 8,
	MonsterInvestigateSpeed = 13,
	MonsterHuntSpeed = 19, -- just under SprintSpeed: sprinting CAN break line, but it screams your position
	MonsterCatchDistance = 5.5,
	MonsterHearingFloor = 6, -- effective loudness below this is not registered
	MonsterInvestigateTime = 6, -- seconds it searches a heard spot before losing interest
	MonsterHuntGrace = 2.5, -- seconds of silence before HUNT downgrades to INVESTIGATE
	MonsterRepath = 0.35, -- seconds between path recomputes
	MonsterHuntNoise = 42, -- heard loudness at short range that escalates INVESTIGATE -> HUNT
	MonsterHuntRange = 22, -- ...within this distance
	PlayerBlindOneEnabled = true, -- with 2+ players, one player replaces the AI
	PlayerBlindOneSpeed = 18,

	-- ---- round ----
	StudioSafeMode = true, -- in Studio the monster can chase, but cannot kill players
	RespawnDelay = 3,
	SpawnGrace = 3, -- seconds of immunity right after (re)spawning
	StartThrowables = 3,
	MaxThrowables = 4,
}
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">JumpPolicy</string>
        <string name="Source"><![CDATA[--!strict
-- Apply on BOTH server and client: Humanoid state-enable flags don't replicate.
local JumpPolicy = {}

function JumpPolicy.Apply(humanoid: Humanoid, survivor: boolean)
	if humanoid:GetAttribute("OriginalJumpPower") == nil then
		humanoid:SetAttribute("OriginalJumpPower", humanoid.JumpPower)
		humanoid:SetAttribute("OriginalJumpHeight", humanoid.JumpHeight)
		humanoid:SetAttribute("OriginalAutoJump", humanoid.AutoJumpEnabled)
		humanoid:SetAttribute("OriginalJumpState", humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping))
	end
	if survivor then
		humanoid.Jump = false
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
		humanoid.AutoJumpEnabled = false
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	else
		humanoid.JumpPower = humanoid:GetAttribute("OriginalJumpPower") :: number
		humanoid.JumpHeight = humanoid:GetAttribute("OriginalJumpHeight") :: number
		humanoid.AutoJumpEnabled = humanoid:GetAttribute("OriginalAutoJump") :: boolean
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, humanoid:GetAttribute("OriginalJumpState") :: boolean)
	end
end

return JumpPolicy
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">MazeLayout</string>
        <string name="Source"><![CDATA[--!strict
-- Fixed, connected labyrinth. Passage bits: north=1, east=2, south=4, west=8.
-- These cells are shared by construction and the bot's navigation fallback.
local Layout = {}
Layout.Size = 19
Layout.Cell = 18
Layout.Wall = 2.8
Layout.Masks = {
	{ 6, 14, 12, 6, 14, 12, 6, 10, 10, 12, 6, 14, 14, 10, 10, 10, 12, 6, 12 },
	{ 5, 3, 11, 9, 7, 9, 3, 14, 10, 13, 7, 9, 5, 2, 10, 12, 3, 9, 5 },
	{ 5, 6, 10, 12, 3, 10, 10, 9, 6, 11, 15, 12, 5, 6, 12, 3, 12, 6, 9 },
	{ 3, 11, 14, 15, 14, 10, 10, 12, 3, 12, 5, 5, 3, 9, 7, 14, 13, 5, 4 },
	{ 6, 10, 15, 15, 15, 14, 12, 5, 6, 13, 3, 15, 10, 14, 15, 15, 13, 7, 13 },
	{ 3, 12, 7, 11, 9, 5, 7, 9, 5, 5, 6, 15, 12, 5, 3, 15, 15, 9, 5 },
	{ 6, 13, 5, 6, 12, 3, 13, 6, 13, 5, 5, 7, 11, 15, 10, 9, 5, 6, 9 },
	{ 5, 3, 13, 5, 5, 6, 15, 11, 9, 7, 15, 11, 10, 15, 12, 6, 11, 11, 12 },
	{ 3, 12, 5, 5, 3, 9, 7, 10, 14, 15, 15, 12, 4, 7, 13, 5, 6, 10, 13 },
	{ 6, 9, 7, 15, 12, 6, 11, 14, 15, 15, 15, 11, 15, 13, 5, 5, 1, 6, 9 },
	{ 5, 6, 9, 5, 7, 15, 10, 9, 7, 11, 15, 10, 9, 5, 3, 11, 12, 3, 12 },
	{ 7, 9, 6, 13, 7, 9, 6, 14, 11, 10, 11, 14, 14, 15, 12, 4, 3, 12, 5 },
	{ 5, 6, 9, 5, 3, 12, 7, 13, 6, 14, 10, 9, 3, 15, 9, 7, 12, 5, 5 },
	{ 5, 3, 14, 15, 12, 3, 15, 13, 5, 3, 12, 6, 10, 15, 14, 15, 15, 9, 5 },
	{ 3, 10, 15, 15, 15, 10, 13, 7, 15, 12, 5, 5, 6, 15, 15, 15, 15, 12, 5 },
	{ 6, 10, 11, 11, 11, 12, 3, 15, 9, 3, 9, 7, 15, 9, 7, 15, 15, 9, 5 },
	{ 3, 10, 12, 6, 12, 3, 12, 7, 14, 12, 6, 9, 3, 10, 9, 5, 7, 10, 13 },
	{ 6, 12, 5, 5, 3, 10, 9, 5, 5, 5, 3, 14, 10, 10, 12, 5, 5, 6, 13 },
	{ 3, 11, 11, 11, 10, 10, 10, 9, 3, 11, 10, 11, 10, 10, 9, 3, 11, 11, 9 },
}
Layout.Rooms = {
	{ Name = "Listening Court", Id = "COURT", X = 10, Z = 10 },
	{ Name = "Generator House", Id = "POWER", X = 4, Z = 5 },
	{ Name = "Drowned Gallery", Id = "WATER", X = 16, Z = 5 },
	{ Name = "Silent Chapel", Id = "CHAPEL", X = 4, Z = 15 },
	{ Name = "Records Yard", Id = "RECORDS", X = 16, Z = 15 },
}
local directions = { {0,-1,1,4}, {1,0,2,8}, {0,1,4,1}, {-1,0,8,2} }
function Layout.Position(x: number, z: number): Vector3
	return Vector3.new((x - 10) * Layout.Cell, 0, (z - 10) * Layout.Cell)
end
function Layout.CellAt(position: Vector3): (number, number)
	return math.clamp(math.floor(position.X / Layout.Cell + 10.5), 1, Layout.Size),
		math.clamp(math.floor(position.Z / Layout.Cell + 10.5), 1, Layout.Size)
end
function Layout.Neighbors(x: number, z: number): {{number}}
	local result = {}
	for _, direction in directions do
		if bit32.band(Layout.Masks[z][x], direction[3]) ~= 0 then
			table.insert(result, {x + direction[1], z + direction[2]})
		end
	end
	return result
end
function Layout.Route(from: Vector3, target: Vector3): {Vector3}
	local sx, sz = Layout.CellAt(from)
	local tx, tz = Layout.CellAt(target)
	local start, finish = (sz-1)*19+sx, (tz-1)*19+tx
	local queue, previous = {start}, {[start] = 0}
	local cursor = 1
	while cursor <= #queue do
		local id = queue[cursor]
		if id == finish then break end
		cursor += 1
		local x, z = (id-1)%19+1, math.floor((id-1)/19)+1
		for _, nextCell in Layout.Neighbors(x, z) do
			local nextId = (nextCell[2]-1)*19+nextCell[1]
			if previous[nextId] == nil then
				previous[nextId] = id
				table.insert(queue, nextId)
			end
		end
	end
	if previous[finish] == nil then return {} end
	local route, id = {}, finish
	while id ~= 0 do
		table.insert(route, 1, Layout.Position((id-1)%19+1, math.floor((id-1)/19)+1))
		id = previous[id]
	end
	table.insert(route, target)
	return route
end
-- Fail before spawning geometry if an edited passage is disconnected or one-way.
function Layout.Validate()
	local edges = 0
	for z, row in Layout.Masks do
		for x, mask in row do
			for _, d in directions do
				if bit32.band(mask, d[3]) ~= 0 then
					local nx, nz = x+d[1], z+d[2]
					assert(nx >= 1 and nx <= 19 and nz >= 1 and nz <= 19, "Maze opening outside boundary")
					assert(bit32.band(Layout.Masks[nz][nx], d[4]) ~= 0, "One-way maze opening")
					edges += 1
				end
			end
			assert(#Layout.Route(Layout.Position(10,19), Layout.Position(x,z)) > 0, "Unreachable maze cell")
		end
	end
	return edges / 2 - 361 + 1
end
return Layout

]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">Remotes</string>
        <string name="Source"><![CDATA[--!strict
-- Shared remote registry. require() this from either side.
-- Server creates the folder + events; client waits for them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = {
	"SetMoveState", -- client -> server: "idle" | "walk" | "crouch" | "sprint"
	"NoiseMeter", -- server -> client: current noise 0..100
	"Dread", -- server -> client: 0..1 proximity of the monster (for the vignette)
	"Throw", -- client -> server: throw a held rock in a direction
	"Pickup", -- client -> server: pick up a nearby rock
	"HeldCount", -- server -> client: how many rocks you hold
	"Objective", -- server -> client: objective text
	"PhotoMode", -- Studio testing: client toggles the solo AI freeze
}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("RemoteEvents") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "RemoteEvents"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		if not folder:FindFirstChild(name) then
			local r = Instance.new("RemoteEvent")
			r.Name = name
			r.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("RemoteEvents") :: Folder
end

local remotes: { [string]: RemoteEvent } = {}
for _, name in NAMES do
	remotes[name] = folder:WaitForChild(name) :: RemoteEvent
end
return remotes
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">GameService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Survivor objective flow for The Hollow:
-- restore three noisy mechanisms, crank open the labyrinth gate, then escape.
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local generatedMap = workspace:WaitForChild("GeneratedMap")
local noiseBindable = ServerStorage:WaitForChild("Noise") :: BindableEvent

local catchBindable = ServerStorage:FindFirstChild("CatchPlayer") :: BindableEvent?
if catchBindable and not catchBindable:IsA("BindableEvent") then
	catchBindable:Destroy()
	catchBindable = nil
end
if not catchBindable then
	catchBindable = Instance.new("BindableEvent")
	catchBindable.Name = "CatchPlayer"
	catchBindable.Parent = ServerStorage
end
for _, child in ServerStorage:GetChildren() do
	if child.Name == "CatchPlayer" and child ~= catchBindable then child:Destroy() end
end
local catchEvent = catchBindable :: BindableEvent

Players.RespawnTime = Config.RespawnDelay
Players.CharacterAutoLoads = true

local caughtDebounce: { [Player]: boolean } = {}
local connectedMechanisms: { [Instance]: boolean } = {}
local connectedCranks: { [Instance]: boolean } = {}
local connectedEscapeZones: { [Instance]: boolean } = {}
local mechanismHolds: { [Player]: boolean } = {}
local crankHolds: { [Player]: boolean } = {}
local gateOpening = false

local function setObjective(player: Player, text: string)
	Remotes.Objective:FireClient(player, text)
end

local function mechanismProgress(): (number, number)
	local active = 0
	local total = 0
	for _, station in CollectionService:GetTagged("GateMechanism") do
		if station:IsDescendantOf(generatedMap) then
			total += 1
			if station:GetAttribute("Activated") == true then active += 1 end
		end
	end
	total = math.max(total, generatedMap:GetAttribute("MechanismsTotal") or 3)
	generatedMap:SetAttribute("MechanismsActive", active)
	generatedMap:SetAttribute("MechanismsTotal", total)
	return active, total
end

local function survivorObjective(): string
	local active, total = mechanismProgress()
	if generatedMap:GetAttribute("GateOpen") == true then
		return "THE GATE IS OPEN — escape the labyrinth."
	elseif active >= total then
		return "ALL MECHANISMS RESTORED — crank open the perimeter gate."
	end
	return ("Restore the gate mechanisms (%d/%d). Stay quiet."):format(active, total)
end

local function broadcastSurvivorObjective(text: string?)
	local message = text or survivorObjective()
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Role") ~= "BlindOne" and player:GetAttribute("Escaped") ~= true then
			setObjective(player, message)
		end
	end
end

local function markPlayerNoise(player: Player, amount: number, duration: number)
	player:SetAttribute("NoiseOverrideLevel", amount)
	player:SetAttribute("NoiseOverrideUntil", os.clock() + duration)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then noiseBindable:Fire(root.Position, amount) end
end

local function removeOrphanedCharacters(player: Player, currentCharacter: Model)
	for _, child in workspace:GetChildren() do
		if child:IsA("Model") and child ~= currentCharacter and child.Name == player.Name and child:FindFirstChildOfClass("Humanoid") then
			child:Destroy()
		end
	end
end

local function onCharacter(player: Player, character: Model)
	player:SetAttribute("HasKey", false)
	player:SetAttribute("Escaped", false)
	player:SetAttribute("NoiseOverrideUntil", 0)
	caughtDebounce[player] = nil
	removeOrphanedCharacters(player, character)
	local forceField = character:FindFirstChildOfClass("ForceField")
	if forceField then forceField:Destroy() end
	task.wait(0.5)
	if player:GetAttribute("Role") == "BlindOne" then
		setObjective(player, "YOU ARE THE BLIND ONE — follow sound and catch every survivor.")
	else
		setObjective(player, survivorObjective())
	end
end

local function setupPlayer(player: Player)
	player:SetAttribute("HasKey", false)
	player:SetAttribute("Escaped", false)
	player.CharacterAdded:Connect(function(character) onCharacter(player, character) end)
	if player.Character then task.spawn(onCharacter, player, player.Character :: Model) end
end

for _, player in Players:GetPlayers() do setupPlayer(player) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(player)
	caughtDebounce[player] = nil
	mechanismHolds[player] = nil
	crankHolds[player] = nil
end)

catchEvent.Event:Connect(function(player: Player, caughtByHuman: boolean?)
	if caughtDebounce[player] or player:GetAttribute("Escaped") == true or player:GetAttribute("Role") == "BlindOne" then return end
	if Config.StudioSafeMode and RunService:IsStudio() and not caughtByHuman then
		caughtDebounce[player] = true
		task.delay(1, function() caughtDebounce[player] = nil end)
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	caughtDebounce[player] = true
	humanoid.Health = 0
end)

--------------------------------------------------------------------- mechanisms
local function stationPosition(station: Instance): Vector3
	if station:IsA("Model") then return station:GetPivot().Position end
	if station:IsA("BasePart") then return station.Position end
	return Vector3.zero
end

local function setMechanismVisual(station: Instance, activated: boolean)
	local core = station:FindFirstChild("Core", true)
	if core and core:IsA("BasePart") then
		core.Color = if activated then Color3.fromRGB(91, 207, 136) else Color3.fromRGB(145, 38, 24)
		for _, child in core:GetChildren() do
			if child:IsA("PointLight") then
				child.Color = core.Color
				child.Brightness = if activated then 0.8 else 0.35
			end
		end
	end
end

local function refreshGatePrompt()
	local active, total = mechanismProgress()
	for _, crank in CollectionService:GetTagged("GateCrank") do
		local prompt = crank:FindFirstChild("GatePrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			if generatedMap:GetAttribute("GateOpen") == true then
				prompt.Enabled = false
			elseif active >= total then
				prompt.ActionText = "Crank open the gate"
				prompt.HoldDuration = 8
			else
				prompt.ActionText = ("Gate locked (%d/%d)"):format(active, total)
				prompt.HoldDuration = 0.35
			end
		end
	end
end

local function connectMechanism(station: Instance)
	if connectedMechanisms[station] then return end
	connectedMechanisms[station] = true
	setMechanismVisual(station, station:GetAttribute("Activated") == true)
	local prompt = station:FindFirstChild("RestorePrompt", true)
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	prompt.PromptButtonHoldBegan:Connect(function(player)
		if player:GetAttribute("Role") == "BlindOne" or station:GetAttribute("Activated") == true then return end
		mechanismHolds[player] = true
		task.spawn(function()
			while mechanismHolds[player] and station.Parent and station:GetAttribute("Activated") ~= true do
				markPlayerNoise(player, 72, 0.85)
				noiseBindable:Fire(stationPosition(station), 72)
				task.wait(0.65)
			end
		end)
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player) mechanismHolds[player] = nil end)
	prompt.Triggered:Connect(function(player)
		mechanismHolds[player] = nil
		if player:GetAttribute("Role") == "BlindOne" or station:GetAttribute("Activated") == true then return end
		station:SetAttribute("Activated", true)
		prompt.Enabled = false
		setMechanismVisual(station, true)
		markPlayerNoise(player, 92, 1.5)
		noiseBindable:Fire(stationPosition(station), 96)
		local active, total = mechanismProgress()
		refreshGatePrompt()
		if active >= total then
			broadcastSurvivorObjective("ALL MECHANISMS RESTORED — crank open the perimeter gate.")
		else
			broadcastSurvivorObjective(("Mechanism restored (%d/%d). Find the others."):format(active, total))
		end
	end)
end

for _, station in CollectionService:GetTagged("GateMechanism") do connectMechanism(station) end
CollectionService:GetInstanceAddedSignal("GateMechanism"):Connect(connectMechanism)

--------------------------------------------------------------------- final gate
local function openGate(player: Player, crank: Instance)
	if gateOpening or generatedMap:GetAttribute("GateOpen") == true then return end
	local active, total = mechanismProgress()
	if active < total then
		setObjective(player, ("The gate is dead. Restore every mechanism (%d/%d)."):format(active, total))
		return
	end
	gateOpening = true
	generatedMap:SetAttribute("GateOpen", true)
	markPlayerNoise(player, 100, 2.5)
	for _, door in CollectionService:GetTagged("EscapeGateDoor") do
		if door:IsA("BasePart") then
			door.CanCollide = false
			local direction = if door.Position.X < 0 then -1 else 1
			TweenService:Create(door, TweenInfo.new(2.8, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut), {
				Position = door.Position + Vector3.new(direction * 10.5, 0, 0),
			}):Play()
		end
	end
	for pulse = 1, 6 do
		noiseBindable:Fire(stationPosition(crank), 100)
		if pulse < 6 then task.wait(0.45) end
	end
	refreshGatePrompt()
	broadcastSurvivorObjective("THE GATE IS OPEN — escape the labyrinth.")
	gateOpening = false
end

local function connectCrank(crank: Instance)
	if connectedCranks[crank] then return end
	connectedCranks[crank] = true
	local prompt = crank:FindFirstChild("GatePrompt")
	if not prompt or not prompt:IsA("ProximityPrompt") then return end
	prompt.PromptButtonHoldBegan:Connect(function(player)
		local active, total = mechanismProgress()
		if player:GetAttribute("Role") == "BlindOne" or active < total then return end
		crankHolds[player] = true
		task.spawn(function()
			while crankHolds[player] and crank.Parent and generatedMap:GetAttribute("GateOpen") ~= true do
				markPlayerNoise(player, 100, 0.9)
				noiseBindable:Fire(stationPosition(crank), 100)
				task.wait(0.55)
			end
		end)
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player) crankHolds[player] = nil end)
	prompt.Triggered:Connect(function(player)
		crankHolds[player] = nil
		if player:GetAttribute("Role") == "BlindOne" then return end
		openGate(player, crank)
	end)
	refreshGatePrompt()
end

for _, crank in CollectionService:GetTagged("GateCrank") do connectCrank(crank) end
CollectionService:GetInstanceAddedSignal("GateCrank"):Connect(connectCrank)

local function connectEscapeZone(zone: Instance)
	if connectedEscapeZones[zone] or not zone:IsA("BasePart") then return end
	connectedEscapeZones[zone] = true
	zone.Touched:Connect(function(hit)
		if generatedMap:GetAttribute("GateOpen") ~= true then return end
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or player:GetAttribute("Role") == "BlindOne" or player:GetAttribute("Escaped") == true then return end
		player:SetAttribute("Escaped", true)
		setObjective(player, "YOU ESCAPED THE HOLLOW.")
		broadcastSurvivorObjective()
	end)
end

for _, zone in CollectionService:GetTagged("EscapeZone") do connectEscapeZone(zone) end
CollectionService:GetInstanceAddedSignal("EscapeZone"):Connect(connectEscapeZone)

task.delay(1, function()
	refreshGatePrompt()
	broadcastSurvivorObjective()
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">MapBuilder</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- The Hollow Labyrinth: a roofed institution maze with five landmarks.
-- City checkpoint: backups/city-2026-09-11 (source + standalone Studio place).
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage:WaitForChild("MazeLayout"))
local MAP_VERSION = "HollowLabyrinth_2"
local oldMap = Workspace:FindFirstChild("GeneratedMap")
if oldMap and oldMap:GetAttribute("MapVersion") == MAP_VERSION then return end
if oldMap then oldMap:Destroy() end
local loopCount = Layout.Validate()

local map = Instance.new("Folder")
map.Name = "GeneratedMap"
map:SetAttribute("MapVersion", MAP_VERSION)
map:SetAttribute("MapKind", "Maze")
map:SetAttribute("MechanismsActive", 0)
map:SetAttribute("MechanismsTotal", 3)
map:SetAttribute("GateOpen", false)
map:SetAttribute("Ready", false)
map.Parent = Workspace
local rng = Random.new(11926)
local C, N, W = Layout.Cell, Layout.Size, Layout.Wall
local HALF, HEIGHT = N * C / 2, 18

local function part(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, parent: Instance?, decorative: boolean?): Part
	local object = Instance.new("Part")
	object.Name, object.Size, object.Position = name, size, position
	object.Color, object.Material, object.Anchored = color, material, true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.CanCollide = decorative ~= true
	object.CanQuery = decorative ~= true
	object.CanTouch = false
	object.Parent = parent or map
	return object
end
local function folder(name: string): Folder
	local result = Instance.new("Folder")
	result.Name, result.Parent = name, map
	return result
end
local function lamp(parent: BasePart, color: Color3, brightness: number, range: number)
	local light = Instance.new("PointLight")
	light.Color, light.Brightness, light.Range, light.Shadows = color, brightness, range, true
	light.Parent = parent
end
local function label(on: BasePart, text: string, color: Color3, face: Enum.NormalId?)
	local gui = Instance.new("SurfaceGui")
	gui.Name, gui.Face, gui.LightInfluence = "PlaqueText", face or Enum.NormalId.Front, 0.4
	gui.SizingMode, gui.PixelsPerStud = Enum.SurfaceGuiSizingMode.PixelsPerStud, 35
	gui.Parent = on
	local textLabel = Instance.new("TextLabel")
	textLabel.Size, textLabel.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	textLabel.Font, textLabel.Text, textLabel.TextColor3 = Enum.Font.SpecialElite, text, color
	textLabel.TextScaled, textLabel.Parent = true, gui
end
local function tube(name: string, a: Vector3, b: Vector3, diameter: number, color: Color3, parent: Instance): Part
	local p = part(name, Vector3.new((b-a).Magnitude, diameter, diameter), (a+b)/2, color, Enum.Material.CorrodedMetal, parent, true)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = CFrame.lookAt((a+b)/2,b) * CFrame.Angles(0, math.rad(90), 0)
	return p
end

-- Atmosphere overrides legacy fog even at zero density. Use one distance-fog
-- renderer, so nearby walls stay crisp and the next corridor vanishes in mist.
for _, effect in Lighting:GetChildren() do
	if effect:IsA("Atmosphere") or effect.Name == "TheHollowGrade"
		or effect.Name == "TheHollowBloom" or effect.Name == "TheHollowDepth" then
		effect:Destroy()
	elseif effect:IsA("SunRaysEffect") then effect.Enabled = false end
end
Lighting.ClockTime, Lighting.Brightness = 5.1, 1.8
Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(48,52,54), Color3.fromRGB(67,72,74)
Lighting.EnvironmentDiffuseScale, Lighting.EnvironmentSpecularScale = 0.4, 0.86
Lighting.GlobalShadows, Lighting.ShadowSoftness, Lighting.ExposureCompensation = true, 0.6, 0.12
Lighting.FogColor, Lighting.FogStart, Lighting.FogEnd = Color3.fromRGB(92,100,103), 12, 92
local grade = Instance.new("ColorCorrectionEffect")
grade.Name, grade.Brightness, grade.Contrast, grade.Saturation = "TheHollowGrade", 0.015, 0.12, -0.3
grade.TintColor, grade.Parent = Color3.fromRGB(222,231,233), Lighting
local bloom = Instance.new("BloomEffect")
bloom.Name, bloom.Intensity, bloom.Size, bloom.Threshold = "TheHollowBloom", 0.16, 22, 1.1
bloom.Parent = Lighting
local depth = Instance.new("DepthOfFieldEffect")
depth.Name, depth.FarIntensity, depth.NearIntensity = "TheHollowDepth", 0.08, 0
depth.FocusDistance, depth.InFocusRadius, depth.Parent = 30, 28, Lighting
local sky = Lighting:FindFirstChildOfClass("Sky")
if not sky then sky = Instance.new("Sky"); sky.Parent = Lighting end
sky.StarCount, sky.CelestialBodiesShown = 0, false
local terrain = Workspace.Terrain
local clouds = terrain:FindFirstChildOfClass("Clouds")
if not clouds then clouds = Instance.new("Clouds"); clouds.Parent = terrain end
clouds.Cover, clouds.Density, clouds.Color = 0.94, 0.75, Color3.fromRGB(87,94,98)

local walls, decor, landmarks, navigation = folder("MazeWalls"), folder("WeatheredDetails"), folder("Landmarks"), folder("Navigation")
local roof = folder("MazeRoof")
-- A solid, queryable ceiling covers every cell, including all five rooms.
-- Free-camera flight may pass through it; characters and rain cannot.
part("ContinuousRoof", Vector3.new(N*C+W+2,2,N*C+W+2), Vector3.new(0,20,0), Color3.fromRGB(48,51,48), Enum.Material.Concrete, roof)
for strip=-3,3 do
	part("CeilingGirder", Vector3.new(N*C,0.65,1), Vector3.new(0,18.65,strip*54), Color3.fromRGB(46,48,43), Enum.Material.CorrodedMetal, roof, true)
end
for z=2,N,3 do
	for x=2,N,3 do
		local position = Layout.Position(x,z) + Vector3.new(0,18.35,0)
		part("CeilingHousing", Vector3.new(4.5,0.4,1.3), position, Color3.fromRGB(32,38,34), Enum.Material.Metal, roof, true)
		local diffuser = part("CeilingDiffuser", Vector3.new(3.8,0.1,0.8), position-Vector3.new(0,0.25,0), Color3.fromRGB(155,168,152), Enum.Material.Neon, roof, true)
		lamp(diffuser, Color3.fromRGB(168,180,164), 0.75, 28)
	end
end
local palettes = {
	{Color3.fromRGB(79,83,70), Enum.Material.Brick, Color3.fromRGB(165,144,94), "01 / POWER"},
	{Color3.fromRGB(68,83,85), Enum.Material.Concrete, Color3.fromRGB(114,153,167), "02 / WATER"},
	{Color3.fromRGB(82,77,74), Enum.Material.Cobblestone, Color3.fromRGB(148,133,151), "03 / CHAPEL"},
	{Color3.fromRGB(89,77,62), Enum.Material.Brick, Color3.fromRGB(166,123,76), "04 / RECORDS"},
}
local function zone(x: number, z: number): number
	return (if z <= 10 then 0 else 2) + (if x <= 10 then 1 else 2)
end
local function roomAt(x: number, z: number): any
	for _, room in Layout.Rooms do
		if math.abs(x-room.X)<=1 and math.abs(z-room.Z)<=1 then return room end
	end
	return nil
end
part("Foundation", Vector3.new(350,2,350), Vector3.new(0,-1,0), Color3.fromRGB(35,39,35), Enum.Material.Ground)
local function wall(position: Vector3, horizontal: boolean, zoneIndex: number)
	local pal = palettes[zoneIndex]
	local size = if horizontal then Vector3.new(C+W,HEIGHT,W) else Vector3.new(W,HEIGHT,C+W)
	local body = part("MazeWall",size,position+Vector3.new(0,HEIGHT/2,0),pal[1],pal[2],walls)
	part("StoneCoping", Vector3.new(size.X+0.3,0.7,size.Z+0.3),position+Vector3.new(0,HEIGHT+0.2,0),Color3.fromRGB(54,60,57),Enum.Material.Concrete,decor,true)
	part("DampFooting",Vector3.new(size.X+0.12,2.4,size.Z+0.12),position+Vector3.new(0,1.2,0),Color3.fromRGB(37,47,39),Enum.Material.Slate,decor,true)
	-- Rain streaks and masonry joints are geometry, with no uploaded textures.
	local tangent = if horizontal then Vector3.new(1,0,0) else Vector3.new(0,0,1)
	local normal = if horizontal then Vector3.new(0,0,1) else Vector3.new(1,0,0)
	for _, side in {-1,1} do
		local stainSize = if horizontal then Vector3.new(rng:NextNumber(0.2,0.6),rng:NextNumber(4,10),0.025) else Vector3.new(0.025,rng:NextNumber(4,10),rng:NextNumber(0.2,0.6))
		local stain = part("RainStain",stainSize,position+tangent*rng:NextNumber(-6,6)+normal*side*(W/2+0.025)+Vector3.new(0,HEIGHT-stainSize.Y/2,0),Color3.fromRGB(30,38,32),Enum.Material.SmoothPlastic,decor,true)
		stain.Transparency = 0.65
	end
	if rng:NextNumber()<0.13 then
		local pipePos = position + normal*(W/2+0.4)
		tube("OldConduit",pipePos+Vector3.new(0,1,0),pipePos+Vector3.new(0,16,0),0.23,Color3.fromRGB(69,65,50),decor)
	end
end

for z=1,N do
	for x=1,N do
		local center, pal = Layout.Position(x,z), palettes[zone(x,z)]
		local room = roomAt(x,z)
		local floor = part("WetFlagstones",Vector3.new(C-0.08,0.2,C-0.08),center+Vector3.new(0,-0.01,0),Color3.fromRGB(47,51,49),Enum.Material.Slate,decor)
		floor.Reflectance = 0.05
		if x<N and bit32.band(Layout.Masks[z][x],2)==0 then wall(center+Vector3.new(C/2,0,0),false,zone(x,z)) end
		if z<N and bit32.band(Layout.Masks[z][x],4)==0 then wall(center+Vector3.new(0,0,C/2),true,zone(x,z)) end
		if x==1 then wall(center-Vector3.new(C/2,0,0),false,zone(x,z)) end
		if x==N then wall(center+Vector3.new(C/2,0,0),false,zone(x,z)) end
		if z==1 and x~=10 then wall(center-Vector3.new(0,0,C/2),true,zone(x,z)) end
		if z==N then wall(center+Vector3.new(0,0,C/2),true,zone(x,z)) end
		if not room and (x+z*3)%9==0 then
			local wet = part("ShallowPuddle",Vector3.new(5+rng:NextNumber(0,4),0.025,3+rng:NextNumber(0,4)),center+Vector3.new(2,0.12,-2),Color3.fromRGB(82,97,101),Enum.Material.Glass,decor,true)
			wet.Transparency,wet.Reflectance = 0.62,0.2
		end
		local node = part("PatrolNode",Vector3.new(1,1,1),center+Vector3.new(0,2,0),Color3.new(),Enum.Material.SmoothPlastic,navigation,true)
		node.Transparency=1
		CollectionService:AddTag(node,"PatrolNode")
		-- Recessed lamps and zone bands at some corners; leave a 12+ stud route.
		if (x*7+z*3)%11==0 and not room then
			local mask=Layout.Masks[z][x]
			local closed = if bit32.band(mask,1)==0 then Vector3.new(0,0,-1) elseif bit32.band(mask,8)==0 then Vector3.new(-1,0,0) else nil
			if closed then
				local lampPos=center+closed*(C/2-W/2-0.55)+Vector3.new(0,9,0)
				local fitting=part("CagedWallLamp",Vector3.new(1.3,0.5,1.3),lampPos,Color3.fromRGB(175,190,177),Enum.Material.Neon,decor,true)
				lamp(fitting, pal[3],0.9,24)
				local band=part("SectorStripe",Vector3.new(if closed.X==0 then 5 else 0.04,0.3,if closed.X==0 then 0.04 else 5),center+closed*(C/2-W/2-0.08)+Vector3.new(0,4.8,0),pal[3],Enum.Material.SmoothPlastic,decor,true)
			end
		end
		if (x*13+z*7)%23==0 and not room then
			local rock=part("Rock",Vector3.one*0.9,center+Vector3.new(-3,0.6,2),Color3.fromRGB(61,58,51),Enum.Material.Rock,map)
			rock.Shape,rock.Anchored,rock.CanTouch=Enum.PartType.Ball,false,true
			CollectionService:AddTag(rock,"Throwable")
		end
	end
end

local function roomSign(center: Vector3, text: string, color: Color3)
	local beam=part("LandmarkSign",Vector3.new(18,3,0.5),center+Vector3.new(0,11,-20),Color3.fromRGB(29,35,33),Enum.Material.Wood,landmarks,true)
	label(beam,text,color,Enum.NormalId.Back)
	label(beam,text,color,Enum.NormalId.Front)
	for _, x in {-9,9} do part("SignPost",Vector3.new(0.4,12,0.4),center+Vector3.new(x,6,-20),Color3.fromRGB(44,48,42),Enum.Material.Metal,landmarks,true) end
end
for _, room in Layout.Rooms do
	local center=Layout.Position(room.X,room.Z)
	roomSign(center,string.upper(room.Name),palettes[zone(room.X,room.Z)][3])
	for _, offset in {Vector3.new(-21,0,-21),Vector3.new(21,0,21)} do
		local post=part("CourtPillar",Vector3.new(2,13,2),center+offset+Vector3.new(0,6.5,0),Color3.fromRGB(77,82,76),Enum.Material.Concrete,landmarks)
		local head=part("CourtLight",Vector3.new(1.5,0.6,1.5),post.Position+Vector3.new(0,6.8,0),Color3.fromRGB(163,183,173),Enum.Material.Neon,landmarks,true)
		lamp(head,head.Color,1.2,34)
	end
	if room.Id=="COURT" then
		local base=part("DryFountainBase",Vector3.new(11,1,11),center+Vector3.new(0,0.5,0),Color3.fromRGB(76,82,76),Enum.Material.Concrete,landmarks)
		local column=part("ListeningMonument",Vector3.new(2.8,12,2.8),center+Vector3.new(0,6.5,0),Color3.fromRGB(66,75,69),Enum.Material.Slate,landmarks)
		part("MonumentCap",Vector3.new(4.3,1,4.3),center+Vector3.new(0,13,0),Color3.fromRGB(100,105,98),Enum.Material.Concrete,landmarks)
		for _, x in {-16,16} do
			part("StoneBench",Vector3.new(3,2,10),center+Vector3.new(x,1,0),Color3.fromRGB(61,68,60),Enum.Material.Slate,landmarks)
		end
	elseif room.Id=="POWER" then
		local machine=part("Generator",Vector3.new(11,6,7),center+Vector3.new(-12,3,4),Color3.fromRGB(71,78,62),Enum.Material.CorrodedMetal,landmarks)
		for x=-4,4,1.1 do part("CoolingFin",Vector3.new(0.18,4,0.3),machine.Position+Vector3.new(x,0,-3.7),Color3.fromRGB(32,36,31),Enum.Material.Metal,landmarks,true) end
		tube("Exhaust",center+Vector3.new(-12,6,5),center+Vector3.new(-12,19,5),1.2,Color3.fromRGB(52,51,45),landmarks)
	elseif room.Id=="WATER" then
		local water=part("FloodedTiles",Vector3.new(32,0.025,31),center+Vector3.new(0,0.13,0),Color3.fromRGB(66,99,105),Enum.Material.Glass,landmarks,true)
		water.Transparency,water.Reflectance=0.52,0.24
		for _, x in {-17,17} do tube("WaterMain",center+Vector3.new(x,2,-17),center+Vector3.new(x,2,17),1.7,Color3.fromRGB(57,90,88),landmarks) end
	elseif room.Id=="CHAPEL" then
		for _, x in {-12,12} do
			for _, z in {-8,3,14} do
				part("PewSeat",Vector3.new(9,0.5,2.5),center+Vector3.new(x,1.7,z),Color3.fromRGB(68,51,36),Enum.Material.WoodPlanks,landmarks)
				part("PewBack",Vector3.new(9,2,0.5),center+Vector3.new(x,2.7,z+1.1),Color3.fromRGB(52,42,32),Enum.Material.WoodPlanks,landmarks)
			end
		end
		part("Altar",Vector3.new(9,3,4),center+Vector3.new(0,1.5,-17),Color3.fromRGB(83,79,71),Enum.Material.Marble,landmarks)
		part("BrokenRoof",Vector3.new(48,1,16),center+Vector3.new(0,19,-17),Color3.fromRGB(48,43,40),Enum.Material.Slate,landmarks)
		for _, x in {-20,20} do part("ChapelColumn",Vector3.new(1.5,19,1.5),center+Vector3.new(x,9.5,-17),Color3.fromRGB(66,63,57),Enum.Material.Concrete,landmarks) end
	elseif room.Id=="RECORDS" then
		for _, x in {-18,18} do
			for _, z in {-13,0,13} do
				local cabinet=part("ArchiveCabinet",Vector3.new(4,6,5),center+Vector3.new(x,3,z),Color3.fromRGB(75,75,62),Enum.Material.CorrodedMetal,landmarks)
				for y=-1.8,1.8,1.8 do part("DrawerHandle",Vector3.new(1.7,0.16,0.2),cabinet.Position+Vector3.new(0,y,-2.65),Color3.fromRGB(127,120,102),Enum.Material.Metal,landmarks,true) end
			end
		end
	end
end

local function mechanism(id: string, displayName: string, center: Vector3)
	local station=Instance.new("Model")
	station.Name,station.Parent="GateMechanism_"..id,map
	station:SetAttribute("MechanismId",id)
	station:SetAttribute("DisplayName",displayName)
	station:SetAttribute("Activated",false)
	local base=part("Base",Vector3.new(4,4.5,2.6),center+Vector3.new(0,2.25,0),Color3.fromRGB(63,72,64),Enum.Material.CorrodedMetal,station)
	station.PrimaryPart=base
	local core=part("Core",Vector3.new(1.4,0.55,0.2),center+Vector3.new(0,3.5,-1.4),Color3.fromRGB(150,62,38),Enum.Material.Neon,station,true)
	lamp(core,core.Color,0.35,8)
	for x=-1,1 do part("Breaker",Vector3.new(0.3,1,0.2),center+Vector3.new(x,2,-1.4),Color3.fromRGB(156,149,112),Enum.Material.Metal,station,true) end
	local prompt=Instance.new("ProximityPrompt")
	prompt.Name,prompt.ActionText,prompt.ObjectText="RestorePrompt","Restore mechanism",displayName
	prompt.KeyboardKeyCode,prompt.GamepadKeyCode=Enum.KeyCode.E,Enum.KeyCode.ButtonX
	prompt.HoldDuration,prompt.MaxActivationDistance,prompt.RequiresLineOfSight=3.2,9,true
	prompt.Parent=base
	CollectionService:AddTag(station,"GateMechanism")
end
mechanism("POWER","Generator House / Power",Layout.Position(4,5)+Vector3.new(14,0,12))
mechanism("WATER","Drowned Gallery / Pump",Layout.Position(16,5)+Vector3.new(11,0,-12))
mechanism("RECORDS","Records Yard / Relay",Layout.Position(16,15)+Vector3.new(0,0,-14))
local spawnPad=Instance.new("SpawnLocation")
spawnPad.Name,spawnPad.Size,spawnPad.Position="Spawn",Vector3.new(6,0.4,6),Layout.Position(10,19)+Vector3.new(0,0.4,0)
spawnPad.Anchored,spawnPad.Transparency,spawnPad.CanCollide,spawnPad.Duration=true,1,false,0
spawnPad.Parent=map
roomSign(Layout.Position(10,19)+Vector3.new(0,0,5),"THE HOLLOW / KEEP QUIET",Color3.fromRGB(185,188,165))

-- Only the locked northern opening leads outside. The gate leaves carry all
-- detail with them; no stationary bars remain across the exit after opening.
local gateCenter=Vector3.new(0,0,-HALF)
part("ExitCanopy",Vector3.new(24,2,30),gateCenter+Vector3.new(0,21,-13),Color3.fromRGB(48,51,48),Enum.Material.Concrete,roof)
part("ExitApron",Vector3.new(28,1,30),gateCenter+Vector3.new(0,-0.5,-10),Color3.fromRGB(50,57,51),Enum.Material.Slate)
for _, x in {-1,1} do
	local door=part("EscapeGateLeaf",Vector3.new(9,18,1.5),gateCenter+Vector3.new(x*4.5,9,0),Color3.fromRGB(56,64,59),Enum.Material.CorrodedMetal)
	CollectionService:AddTag(door,"EscapeGateDoor")
	part("ExitSidewall",Vector3.new(2.8,20,29),gateCenter+Vector3.new(x*10.4,10,-13),Color3.fromRGB(68,73,66),Enum.Material.Brick,walls)
end
local header=part("ExitHeader",Vector3.new(22,3,3),gateCenter+Vector3.new(0,19,0),Color3.fromRGB(73,79,69),Enum.Material.Concrete)
label(header,"PERIMETER / EXIT",Color3.fromRGB(179,189,162),Enum.NormalId.Back)
local crank=part("GateCrank",Vector3.new(2,3.5,2),gateCenter+Vector3.new(6,1.75,7),Color3.fromRGB(74,78,63),Enum.Material.CorrodedMetal)
local prompt=Instance.new("ProximityPrompt")
prompt.Name,prompt.ActionText,prompt.ObjectText="GatePrompt","Gate locked (0/3)","Labyrinth perimeter"
prompt.KeyboardKeyCode,prompt.GamepadKeyCode=Enum.KeyCode.E,Enum.KeyCode.ButtonX
prompt.HoldDuration,prompt.MaxActivationDistance,prompt.RequiresLineOfSight=0.35,9,true
prompt.Parent=crank
CollectionService:AddTag(crank,"GateCrank")
local escape=part("EscapeZone",Vector3.new(17,10,5),gateCenter+Vector3.new(0,5,-14),Color3.new(),Enum.Material.SmoothPlastic,map,true)
escape.Transparency,escape.CanTouch=1,true
CollectionService:AddTag(escape,"EscapeZone")
map:SetAttribute("Ready",true)
print(("MapBuilder: Hollow Labyrinth ready — 342x342 studs, %d loops, %d instances"):format(loopCount,#map:GetDescendants()))
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="10">
      <Properties>
        <string name="Name">MonsterAppearance</string>
        <string name="Source"><![CDATA[--!strict
-- Roblox-native analog-horror appearance shared by the solo AI and the
-- player-controlled Blind One. It intentionally uses only Parts, WedgeParts,
-- native materials, lights, and welds: no Blender mesh or uploaded asset.
-- The player's catalog avatar is hidden rather than destroyed so it can be
-- restored if their role changes.

local MonsterAppearance = {}

local VISUAL_NAME = "BlindOneVisual"
local ORIGINAL_TRANSPARENCY = "BlindOneOriginalTransparency"
local ORIGINAL_CAST_SHADOW = "BlindOneOriginalCastShadow"
local ORIGINAL_SCALE = "BlindOneOriginalScale"

local CLOTH = Color3.fromRGB(29, 29, 31)
local CLOTH_LIGHT = Color3.fromRGB(42, 41, 42)
local CLOTH_DEEP = Color3.fromRGB(8, 8, 10)
local SKIN = Color3.fromRGB(24, 24, 25)
local MASK = Color3.fromRGB(172, 168, 154)
local MASK_SHADOW = Color3.fromRGB(116, 114, 106)
local SEAM = Color3.fromRGB(12, 12, 14)
local EYE = Color3.fromRGB(230, 245, 255)

local BODY_SCALES: { [string]: Vector3 } = {
	UpperTorso = Vector3.new(0.82, 1.14, 0.84),
	LowerTorso = Vector3.new(0.68, 1.12, 0.78),
	Torso = Vector3.new(0.82, 1.12, 0.84),
	LeftUpperArm = Vector3.new(0.7, 1.18, 0.72),
	RightUpperArm = Vector3.new(0.7, 1.18, 0.72),
	LeftLowerArm = Vector3.new(0.68, 1.28, 0.7),
	RightLowerArm = Vector3.new(0.68, 1.28, 0.7),
	["Left Arm"] = Vector3.new(0.7, 1.2, 0.72),
	["Right Arm"] = Vector3.new(0.7, 1.2, 0.72),
	LeftHand = Vector3.new(0.72, 1.2, 0.78),
	RightHand = Vector3.new(0.72, 1.2, 0.78),
	LeftUpperLeg = Vector3.new(0.76, 1.16, 0.8),
	RightUpperLeg = Vector3.new(0.76, 1.16, 0.8),
	LeftLowerLeg = Vector3.new(0.72, 1.2, 0.76),
	RightLowerLeg = Vector3.new(0.72, 1.2, 0.76),
	["Left Leg"] = Vector3.new(0.74, 1.16, 0.78),
	["Right Leg"] = Vector3.new(0.74, 1.16, 0.78),
	LeftFoot = Vector3.new(0.84, 1.02, 0.96),
	RightFoot = Vector3.new(0.84, 1.02, 0.96),
}

local SCALE_TARGETS: { [string]: number } = {
	BodyHeightScale = 1.28,
	BodyWidthScale = 0.72,
	BodyDepthScale = 0.78,
	HeadScale = 0.82,
	BodyTypeScale = 0,
	BodyProportionScale = 0,
}

local function configurePart(part: BasePart, name: string, color: Color3, material: Enum.Material)
	part.Name = name
	part.Color = color
	part.Material = material
	part.Massless = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function weldedPart(
	visual: Model,
	anchor: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	configurePart(part, name, color, material)
	part.Size = size
	part.Shape = shape or Enum.PartType.Block
	part.CFrame = anchor.CFrame * offset
	part.Parent = visual
	local weld = Instance.new("WeldConstraint")
	weld.Name = "AnalogVisualWeld"
	weld.Part0 = anchor
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function weldedRod(
	visual: Model,
	anchor: BasePart,
	name: string,
	fromLocal: Vector3,
	toLocal: Vector3,
	thickness: number,
	color: Color3,
	material: Enum.Material
): Part
	local fromWorld = anchor.CFrame:PointToWorldSpace(fromLocal)
	local toWorld = anchor.CFrame:PointToWorldSpace(toLocal)
	local midpoint = (fromWorld + toWorld) / 2
	local length = math.max((toWorld - fromWorld).Magnitude, 0.05)
	local part = Instance.new("Part")
	configurePart(part, name, color, material)
	part.Size = Vector3.new(math.max(thickness, 0.05), math.max(thickness, 0.05), length)
	part.CFrame = CFrame.lookAt(midpoint, toWorld)
	part.Parent = visual
	local weld = Instance.new("WeldConstraint")
	weld.Name = "AnalogVisualWeld"
	weld.Part0 = anchor
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function findPart(character: Model, names: { string }): BasePart?
	for _, name in names do
		local candidate = character:FindFirstChild(name)
		if candidate and candidate:IsA("BasePart") then
			return candidate
		end
	end
	return nil
end

local function hideAvatar(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			if descendant:GetAttribute(ORIGINAL_TRANSPARENCY) == nil then
				descendant:SetAttribute(ORIGINAL_TRANSPARENCY, descendant.Transparency)
				descendant:SetAttribute(ORIGINAL_CAST_SHADOW, descendant.CastShadow)
			end
			descendant.Transparency = 1
			descendant.CastShadow = false
		end
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		for scaleName, target in SCALE_TARGETS do
			local scale = humanoid:FindFirstChild(scaleName)
			if scale and scale:IsA("NumberValue") then
				if scale:GetAttribute(ORIGINAL_SCALE) == nil then
					scale:SetAttribute(ORIGINAL_SCALE, scale.Value)
				end
				scale.Value = target
			end
		end
	end
end

local function restoreAvatar(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			local transparency = descendant:GetAttribute(ORIGINAL_TRANSPARENCY)
			local castShadow = descendant:GetAttribute(ORIGINAL_CAST_SHADOW)
			if typeof(transparency) == "number" then
				descendant.Transparency = transparency
				descendant:SetAttribute(ORIGINAL_TRANSPARENCY, nil)
			end
			if typeof(castShadow) == "boolean" then
				descendant.CastShadow = castShadow
				descendant:SetAttribute(ORIGINAL_CAST_SHADOW, nil)
			end
		elseif descendant:IsA("NumberValue") then
			local scale = descendant:GetAttribute(ORIGINAL_SCALE)
			if typeof(scale) == "number" then
				descendant.Value = scale
				descendant:SetAttribute(ORIGINAL_SCALE, nil)
			end
		end
	end
end

function MonsterAppearance.Clear(character: Model)
	local visual = character:FindFirstChild(VISUAL_NAME)
	if visual then
		visual:Destroy()
	end
	restoreAvatar(character)
end

local function addBodyShell(visual: Model, character: Model)
	for bodyName, scale in BODY_SCALES do
		local bodyPart = character:FindFirstChild(bodyName)
		if bodyPart and bodyPart:IsA("BasePart") then
			local isHand = string.find(bodyName, "Hand") ~= nil
			local isFoot = string.find(bodyName, "Foot") ~= nil
			local color = if isHand then SKIN else CLOTH
			local material = if isHand or isFoot then Enum.Material.Slate else Enum.Material.Fabric
			weldedPart(
				visual,
				bodyPart,
				"AnalogBodySegment",
				Vector3.new(bodyPart.Size.X * scale.X, bodyPart.Size.Y * scale.Y, bodyPart.Size.Z * scale.Z),
				CFrame.identity,
				color,
				material
			)
		end
	end
end

local function characterFloorY(character: Model, root: BasePart): number
	local floorY = root.Position.Y - 3
	for _, child in character:GetChildren() do
		if child:IsA("BasePart") and child ~= root then
			floorY = math.min(floorY, child.Position.Y - child.Size.Y / 2)
		end
	end
	return floorY
end

local function addFace(visual: Model, head: BasePart)
	local tilt = CFrame.Angles(math.rad(-3), math.rad(2), math.rad(-7))
	weldedPart(
		visual,
		head,
		"BlackHeadShroud",
		Vector3.new(1.42, 1.92, 1.28),
		CFrame.new(0, 0.06, 0.02) * tilt,
		CLOTH_DEEP,
		Enum.Material.Fabric,
		Enum.PartType.Ball
	)
	weldedPart(
		visual,
		head,
		"PaleMaskUpper",
		Vector3.new(0.9, 0.92, 0.2),
		CFrame.new(-0.02, 0.13, -0.69) * tilt,
		MASK,
		Enum.Material.Concrete,
		Enum.PartType.Ball
	)
	weldedPart(
		visual,
		head,
		"PaleMaskLower",
		Vector3.new(0.62, 1.05, 0.18),
		CFrame.new(0.02, -0.45, -0.68) * tilt,
		MASK_SHADOW,
		Enum.Material.Concrete,
		Enum.PartType.Ball
	)

	for index, data in {
		{ 0.24, -8 },
		{ 0.13, 5 },
		{ 0.03, -3 },
	} do
		local band = weldedPart(
			visual,
			head,
			"BlindfoldLayer",
			Vector3.new(1.18 + index * 0.045, 0.18, 0.12),
			CFrame.new(0, data[1], -0.82) * CFrame.Angles(0, 0, math.rad(data[2])),
			CLOTH_DEEP,
			Enum.Material.Fabric
		)
		band.CastShadow = false
	end

	for _, side in { -1, 1 } do
		weldedPart(
			visual,
			head,
			"BlindfoldWrap",
			Vector3.new(0.2, 0.52, 0.82),
			CFrame.new(0.65 * side, 0.12, -0.02) * CFrame.Angles(0, 0, math.rad(8 * side)),
			CLOTH,
			Enum.Material.Fabric
		)
	end

	for _, x in { -0.2, 0.2 } do
		local eye = weldedPart(
			visual,
			head,
			"PinpointBlindEye",
			Vector3.new(0.075, 0.038, 0.035),
			CFrame.new(x, 0.17, -0.9),
			EYE,
			Enum.Material.Neon,
			Enum.PartType.Ball
		)
		eye.CastShadow = false
		local halo = weldedPart(
			visual,
			head,
			"EyeLeak",
			Vector3.new(0.16, 0.075, 0.025),
			CFrame.new(x, 0.17, -0.914),
			EYE,
			Enum.Material.Neon
		)
		halo.Transparency = 0.74
		halo.CastShadow = false
		local light = Instance.new("PointLight")
		light.Name = "ColdEyeGlow"
		light.Color = EYE
		light.Brightness = 0.28
		light.Range = 2.6
		light.Shadows = false
		light.Parent = eye
	end

	weldedPart(
		visual,
		head,
		"ClosedFaceSeam",
		Vector3.new(0.04, 0.5, 0.03),
		CFrame.new(0.025, -0.47, -0.79) * CFrame.Angles(0, 0, math.rad(-3)),
		SEAM,
		Enum.Material.SmoothPlastic
	)

	for _, x in { -0.43, 0.46 } do
		weldedRod(
			visual,
			head,
			"HangingHeadThread",
			Vector3.new(x, -0.52, 0.22),
			Vector3.new(x * 1.08, -1.18, 0.28),
			0.05,
			CLOTH_DEEP,
			Enum.Material.Fabric
		)
	end
end

local function addUpperGarment(visual: Model, torso: BasePart)
	local front = -(torso.Size.Z / 2 + 0.12)
	local back = torso.Size.Z / 2 + 0.12
	weldedPart(
		visual,
		torso,
		"RobeChest",
		Vector3.new(torso.Size.X * 1.03, torso.Size.Y * 1.12, torso.Size.Z * 1.12),
		CFrame.new(0, -0.05, 0),
		CLOTH,
		Enum.Material.Fabric
	)

	for _, data in {
		{ 0.62, 2.18, -7 },
		{ 0.43, 2.02, 4 },
		{ 0.24, 1.88, -2 },
	} do
		weldedPart(
			visual,
			torso,
			"CowlFold",
			Vector3.new(data[2], 0.23, 0.22),
			CFrame.new(0, data[1], front - 0.03) * CFrame.Angles(0, 0, math.rad(data[3])),
			CLOTH_LIGHT,
			Enum.Material.Fabric
		)
	end

	for _, side in { -1, 1 } do
		weldedPart(
			visual,
			torso,
			"DroopingShoulderCloth",
			Vector3.new(0.78, if side < 0 then 0.72 else 0.52, torso.Size.Z * 1.2),
			CFrame.new((torso.Size.X / 2 + 0.22) * side, if side < 0 then 0.28 else 0.39, 0.02)
				* CFrame.Angles(0, 0, math.rad(11 * side)),
			if side < 0 then CLOTH_LIGHT else CLOTH,
			Enum.Material.Fabric
		)
	end

	local backDrape = weldedPart(
		visual,
		torso,
		"BackDrape",
		Vector3.new(torso.Size.X * 0.92, torso.Size.Y * 1.45, 0.2),
		CFrame.new(0.08, -0.3, back) * CFrame.Angles(math.rad(2), 0, math.rad(4)),
		CLOTH_LIGHT,
		Enum.Material.Fabric
	)
	backDrape.CastShadow = true

	for _, x in { -0.47, -0.17, 0.18, 0.48 } do
		local fold = weldedPart(
			visual,
			torso,
			"FrontClothFold",
			Vector3.new(0.05, torso.Size.Y * 0.8, 0.05),
			CFrame.new(x * torso.Size.X * 0.72, -0.12, front - 0.135),
			CLOTH_DEEP,
			Enum.Material.SmoothPlastic
		)
		fold.Transparency = 0.18
		fold.CastShadow = false
	end

	weldedPart(
		visual,
		torso,
		"BackCenterSeam",
		Vector3.new(0.05, torso.Size.Y * 1.18, 0.05),
		CFrame.new(0.08, -0.28, back + 0.12),
		CLOTH_DEEP,
		Enum.Material.SmoothPlastic
	)
end

local function addLongRobe(visual: Model, character: Model, lowerTorso: BasePart, root: BasePart)
	local floorY = characterFloorY(character, root)
	local drop = math.clamp(lowerTorso.Position.Y - floorY - 0.12, 2.7, 3.7)
	local panelWidth = math.max(0.62, lowerTorso.Size.X * 0.56)
	local panelDepth = math.max(0.32, lowerTorso.Size.Z * 0.48)
	local xOffset = panelWidth * 0.54
	local front = -(lowerTorso.Size.Z / 2 + panelDepth * 0.36)
	local back = lowerTorso.Size.Z / 2 + panelDepth * 0.36
	local centerY = -(drop / 2 - 0.32)

	for _, side in { -1, 1 } do
		weldedPart(
			visual,
			lowerTorso,
			"FrontRobePanel",
			Vector3.new(panelWidth, drop, panelDepth),
			CFrame.new(xOffset * side, centerY, front) * CFrame.Angles(math.rad(-1), 0, math.rad(-2.5 * side)),
			if side < 0 then CLOTH else CLOTH_LIGHT,
			Enum.Material.Fabric
		)
		weldedPart(
			visual,
			lowerTorso,
			"BackRobePanel",
			Vector3.new(panelWidth, drop * 0.98, panelDepth),
			CFrame.new(xOffset * side, centerY + 0.04, back) * CFrame.Angles(math.rad(1), 0, math.rad(2 * side)),
			CLOTH,
			Enum.Material.Fabric
		)
	end

	for _, side in { -1, 1 } do
		weldedPart(
			visual,
			lowerTorso,
			"SideRobePanel",
			Vector3.new(0.2, drop * 0.9, lowerTorso.Size.Z * 1.18),
			CFrame.new((panelWidth + 0.18) * side, centerY + 0.08, 0),
			CLOTH_DEEP,
			Enum.Material.Fabric
		)
	end

	for index, x in { -0.72, -0.36, 0, 0.34, 0.7 } do
		local length = 0.26 + (index % 3) * 0.12
		weldedPart(
			visual,
			lowerTorso,
			"FrayedHem",
			Vector3.new(0.2, length, 0.22),
			CFrame.new(x, 0.3 - drop - length / 2, front - 0.04) * CFrame.Angles(0, 0, math.rad((index - 3) * 3)),
			CLOTH_DEEP,
			Enum.Material.Fabric
		)
	end

	for _, x in { -0.48, -0.16, 0.2, 0.52 } do
		local fold = weldedPart(
			visual,
			lowerTorso,
			"LongRobeFold",
			Vector3.new(0.05, drop * 0.74, 0.05),
			CFrame.new(x, centerY - 0.08, front - panelDepth / 2 - 0.025),
			CLOTH_DEEP,
			Enum.Material.SmoothPlastic
		)
		fold.Transparency = 0.16
		fold.CastShadow = false
	end

	weldedPart(visual, lowerTorso, "ClothBeltFront", Vector3.new(1.72, 0.16, 0.18), CFrame.new(0, 0.34, front - 0.08), CLOTH_LIGHT, Enum.Material.Fabric)
	weldedPart(visual, lowerTorso, "ClothBeltBack", Vector3.new(1.72, 0.16, 0.18), CFrame.new(0, 0.34, back + 0.08), CLOTH_LIGHT, Enum.Material.Fabric)
	for _, side in { -1, 1 } do
		weldedPart(visual, lowerTorso, "ClothBeltSide", Vector3.new(0.16, 0.16, lowerTorso.Size.Z * 1.2), CFrame.new(0.86 * side, 0.34, 0), CLOTH_LIGHT, Enum.Material.Fabric)
	end
	weldedPart(visual, lowerTorso, "BeltKnot", Vector3.new(0.28, 0.24, 0.2), CFrame.new(0.2, 0.3, back + 0.18), CLOTH_LIGHT, Enum.Material.Fabric, Enum.PartType.Ball)
	for _, x in { 0.1, 0.31 } do
		weldedPart(
			visual,
			lowerTorso,
			"BackSashTail",
			Vector3.new(0.17, drop * 0.63, 0.12),
			CFrame.new(x, -(drop * 0.34), back + 0.16) * CFrame.Angles(math.rad(2), 0, math.rad(if x < 0.2 then -4 else 5)),
			CLOTH_LIGHT,
			Enum.Material.Fabric
		)
	end
end

local function addLimbWraps(visual: Model, limb: BasePart, prefix: string)
	for index, y in { -0.22, 0.14 } do
		weldedPart(
			visual,
			limb,
			prefix .. "Wrap",
			Vector3.new(limb.Size.X * 0.92, 0.11, limb.Size.Z * 0.92),
			CFrame.new(0, y * limb.Size.Y, 0) * CFrame.Angles(0, 0, math.rad(if index == 1 then -6 else 5)),
			CLOTH_LIGHT,
			Enum.Material.Fabric
		)
	end
end

local function addHand(visual: Model, hand: BasePart, side: number)
	local palmHeight = math.clamp(hand.Size.Y * 0.9, 0.7, 1)
	local palmCenterY = -(hand.Size.Y / 2 + palmHeight / 2 - 0.2)
	weldedPart(
		visual,
		hand,
		"LongPalm",
		Vector3.new(0.46, palmHeight, 0.3),
		CFrame.new(0, palmCenterY, -0.02) * CFrame.Angles(math.rad(3), 0, math.rad(2 * side)),
		SKIN,
		Enum.Material.Slate
	)

	local fingerTop = palmCenterY - palmHeight / 2 + 0.12
	for index, x in { -0.18, -0.06, 0.06, 0.18 } do
		local outer = math.abs(index - 2.5) / 1.5
		weldedRod(
			visual,
			hand,
			"LongFinger",
			Vector3.new(x, fingerTop, -0.03),
			Vector3.new(x + (index - 2.5) * 0.055 * side, fingerTop - 0.62 - outer * 0.12, -0.08),
			0.055,
			SKIN,
			Enum.Material.Slate
		)
	end
end

local function addLimbDetails(visual: Model, character: Model)
	local leftLowerArm = findPart(character, { "LeftLowerArm", "Left Arm" })
	local rightLowerArm = findPart(character, { "RightLowerArm", "Right Arm" })
	local leftLowerLeg = findPart(character, { "LeftLowerLeg", "Left Leg" })
	local rightLowerLeg = findPart(character, { "RightLowerLeg", "Right Leg" })
	if leftLowerArm then
		addLimbWraps(visual, leftLowerArm, "LeftCuff")
	end
	if rightLowerArm then
		addLimbWraps(visual, rightLowerArm, "RightCuff")
	end
	if leftLowerLeg then
		addLimbWraps(visual, leftLowerLeg, "LeftAnkle")
	end
	if rightLowerLeg then
		addLimbWraps(visual, rightLowerLeg, "RightAnkle")
	end

	local leftHand = findPart(character, { "LeftHand", "Left Arm" })
	local rightHand = findPart(character, { "RightHand", "Right Arm" })
	if leftHand then
		addHand(visual, leftHand, -1)
	end
	if rightHand then
		addHand(visual, rightHand, 1)
	end
end

function MonsterAppearance.Apply(character: Model)
	MonsterAppearance.Clear(character)
	hideAvatar(character)

	local visual = Instance.new("Model")
	visual.Name = VISUAL_NAME
	visual:SetAttribute("Articulated", true)
	visual:SetAttribute("DesignVersion", "AnalogNativeV1")
	visual:SetAttribute("UsesImportedAsset", false)
	visual.Parent = character

	addBodyShell(visual, character)

	local head = findPart(character, { "Head" })
	if head then
		addFace(visual, head)
	end

	local upperTorso = findPart(character, { "UpperTorso", "Torso" })
	if upperTorso then
		addUpperGarment(visual, upperTorso)
	end

	local lowerTorso = findPart(character, { "LowerTorso", "Torso" })
	local root = findPart(character, { "HumanoidRootPart" })
	if lowerTorso and root then
		addLongRobe(visual, character, lowerTorso, root)
	end

	addLimbDetails(visual, character)

end

return MonsterAppearance
]]></string>
